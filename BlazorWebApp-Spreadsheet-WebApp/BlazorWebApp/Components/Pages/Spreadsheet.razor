@page "/Spreadsheet"

@rendermode InteractiveAuto

@using Microsoft.AspNetCore.Components.Forms
@using Syncfusion.Blazor.Spreadsheet
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Grids

<SfButton CssClass="e-primary me-2" @onclick="DownloadFromGrid">
    1) Download from Grid
</SfButton>

<label class="btn btn-secondary">
    2) Open Exported File → Calculate → Preview
    <InputFile class="d-none" OnChange="OnOpenExportedFile" />
</label>
<SfGrid TItem="Order" @ref="GridRef" DataSource="Orders" AllowPaging="true" Height="280"  AllowExcelExport="true">
    <GridColumns>
        <GridColumn Field="@nameof(Order.OrderID)" HeaderText="Order ID"  Width="120" IsPrimaryKey="true" />
        <GridColumn Field="@nameof(Order.CustomerID)" HeaderText="Customer" Width="150" />
        <GridColumn Field="@nameof(Order.Freight)" HeaderText="Freight" Width="120" Format="C2"  />
        <GridColumn Field="@nameof(Order.ShipCity)" HeaderText="Ship City" Width="150" />
    </GridColumns>
</SfGrid>
@if (SpreadsheetBytes is not null)
{
    <div class="mt-3">
        <SfSpreadsheet DataSource="@SpreadsheetBytes"
                       AllowNumberFormatting="true" AllowCellFormatting="true" AllowAutofill="true">
            <SpreadsheetRibbon></SpreadsheetRibbon>
        </SfSpreadsheet>
    </div>
}
@code {
    private SfGrid<Order>? GridRef;
    private byte[]? SpreadsheetBytes;

    private async Task DownloadFromGrid()
    {
        // Native export (download only, no bytes returned)
        var props = new ExcelExportProperties { FileName = $"Orders_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx" };
        await GridRef!.ExportToExcelAsync(props); // user downloads the file
        // NOTE: This API *does not* give you the bytes programmatically. [1](https://help.syncfusion.com/document-processing/excel/spreadsheet/blazor/getting-started-webapp)
    }

    private async Task OnOpenExportedFile(InputFileChangeEventArgs e)
    {
        // 0) Read the user-selected exported file into memory
        using var input = e.File.OpenReadStream(long.MaxValue);
        using var raw = new MemoryStream();
        await input.CopyToAsync(raw);
        raw.Position = 0;

        // 1) Open the exported workbook with XlsIO
        using var engine = new Syncfusion.XlsIO.ExcelEngine();
        var app = engine.Excel;
        var wb = app.Workbooks.Open(raw);  // open the ACTUAL exported file [3](https://blazor.syncfusion.com/documentation/getting-started/license-key/how-to-register-in-a-razor-class-library)
       
        // 3) Save back to bytes
        using var msOut = new MemoryStream();
        wb.SaveAs(msOut);                        // Blazor + XlsIO: open/save via stream [3](https://blazor.syncfusion.com/documentation/getting-started/license-key/how-to-register-in-a-razor-class-library)
        SpreadsheetBytes = msOut.ToArray();

        // 4) Re-render Spreadsheet with the calculated workbook
        await InvokeAsync(StateHasChanged);
    }

    public class Order
    {
        public int OrderID { get; set; }
        public string CustomerID { get; set; } = "";
        public double Freight { get; set; }
        public string ShipCity { get; set; } = "";
    }
    private List<Order> Orders = new()
    {
        new() { OrderID = 10001, CustomerID = "ALFKI", Freight = 2.30, ShipCity = "Denmark" },
        new() { OrderID = 10002, CustomerID = "ANATR", Freight = 3.30, ShipCity = "Brazil" },
        new() { OrderID = 10003, CustomerID = "ANTON", Freight = 4.30, ShipCity = "Germany" },
    };
}