{
  "name": "sf-grid-element",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "build:elem": "ng build --configuration production --output-hashing=none --single-bundle true",
    "copy:to-blazor": "cross-env SRC=dist/sf-grid-element DEST=../BlazorHost/wwwroot/lib/sf-grid && rimraf %DEST% && mkdir -p %DEST% && cpy \"${SRC}/**/*\" \"${DEST}\" --flat",
    "build:and:copy": "npm-run-all build:elem copy:to-blazor",
    "watch:elem": "chokidar \"src/**/*\" -c \"npm-run-all build:elem copy:to-blazor\""
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@10.8.2",
  "dependencies": {
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/elements": "^21.1.5",
    "@angular/forms": "^21.1.0",
    "@angular/platform-browser": "^21.1.0",
    "@angular/router": "^21.1.0",
    "@syncfusion/ej2-angular-grids": "^32.2.5",
    "@syncfusion/ej2-base": "^32.2.6",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.1.4",
    "@angular/cli": "^21.1.4",
    "@angular/compiler-cli": "^21.1.0",
    "jsdom": "^27.1.0",
    "ngx-build-plus": "^20.0.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
