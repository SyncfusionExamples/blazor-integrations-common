@inject IJSRuntime JS

<div class="dashboard-wrap">
    <SfTab Height="100%"
           OverflowMode="OverflowMode.Scrollable"
           EnablePersistence="false"
           EnableLazyLoad="false">
        <TabEvents Created="OnTabCreated" Selected="OnTabSelected"></TabEvents>
        <TabItems>
            @foreach (var framework in Frameworks)
            {
                var count = framework.Value.Count;
                <TabItem>
                    <ChildContent>
                        <TabHeader Text="@($"{framework.Key} ({count})")" />
                    </ChildContent>
                    <ContentTemplate>
                        <div class="tool-accordion-scroll">
                            <div class="tab-cases-list">
                                <SfAccordion ExpandMode="ExpandMode.Single">
                                    <AccordionItems>
                                        @foreach (var tc in framework.Value)
                                        {
                                            <AccordionItem Expanded="false">
                                                <HeaderTemplate>
                                                    <span class="accordion-case-header" title="@tc.Name">@tc.Name</span>
                                                </HeaderTemplate>
                                                <ContentTemplate>
                                                    <div class="accordion-case-details">
                                                        <div class="test-definition">
                                                            <span>@(tc.Description ?? "No description available for this test.")</span>
                                                        </div>

                                                        <div class="case-tabs-wrap">
                                                            <SfTab CssClass="full-height-tabs"
                                                                   HeaderPlacement="HeaderPosition.Top"
                                                                   EnablePersistence="false">
                                                                <TabItems>
                                                                    <TabItem>
                                                                        <ChildContent>
                                                                            <TabHeader Text="Code" />
                                                                        </ChildContent>
                                                                        <ContentTemplate>
                                                                            @if (!string.IsNullOrEmpty(tc.Code))
                                                                            {
                                                                                <div class="test-code-block">
                                                                                    <pre><code class="language-csharp">@tc.Code</code></pre>
                                                                                </div>
                                                                            }
                                                                            else
                                                                            {
                                                                                <div class="test-no-details">No code available.</div>
                                                                            }
                                                                        </ContentTemplate>
                                                                    </TabItem>
                                                                    <TabItem>
                                                                        <ChildContent>
                                                                            <TabHeader Text="Steps" />
                                                                        </ChildContent>
                                                                        <ContentTemplate>
                                                                            @if (tc.Steps != null && tc.Steps.Count > 0)
                                                                            {
                                                                                <div class="test-steps-panel">
                                                                                    <ol class="test-steps-panel__list">
                                                                                        @foreach (var step in tc.Steps)
                                                                                        {
                                                                                            <li>@step</li>
                                                                                        }
                                                                                    </ol>
                                                                                </div>
                                                                            }
                                                                            else
                                                                            {
                                                                                <div class="test-no-details">No steps available.</div>
                                                                            }
                                                                        </ContentTemplate>
                                                                    </TabItem>
                                                                </TabItems>
                                                            </SfTab>
                                                        </div>
                                                    </div>
                                                </ContentTemplate>
                                            </AccordionItem>
                                        }
                                    </AccordionItems>
                                </SfAccordion>
                            </div>
                        </div>
                    </ContentTemplate>
                </TabItem>
            }
        </TabItems>
    </SfTab>
</div>

@code {
    // Intentional difference from React: framework names are bUnit / xUnit / MSTest / Playwright
    private readonly List<KeyValuePair<string, List<TestCase>>> Frameworks = new()
    {
        new("bUnit",      TestCaseRepository.BUnitCases),
        new("xUnit",      TestCaseRepository.xUnitCases),
        new("MSTest",     TestCaseRepository.MSTestCases),
        new("Playwright", TestCaseRepository.PlaywrightCases),
    };

    // Mirrors React's `created` callback. TabEvents.Created is EventCallback<object>.
    private async Task OnTabCreated(object args)
    {
        await HighlightCodeAsync();
    }

    // Mirrors React's `selected` callback (handleTabSelected(e)).
    private async Task OnTabSelected(SelectEventArgs args)
    {
        await HighlightCodeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await HighlightCodeAsync();
        }
    }

    private async Task HighlightCodeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("highlightAllCode");
        }
        catch
        {
            /* swallow during SSR / pre-render */
        }
    }
}