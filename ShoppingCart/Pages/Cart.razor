@page "/cart"
@using ShoppingCart.Models
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Buttons
@implements IDisposable
@inject ICartService CartService
@inject NavigationManager NavigationManager

<PageTitle>Shopping Cart</PageTitle>

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-lg-8">
            <h3 class="mb-3">🛒 Shopping Cart</h3>

            @if (!CartService.Items.Any())
            {
                <p>Your cart is empty.</p>
            }
            else
            {
                <SfGrid TItem="CartItem"
                        DataSource="@CartService.Items"
                        AllowPaging="false">

                    <GridColumns>

                        <!-- Product -->
                        <GridColumn HeaderText="Item" Width="220">
                            <Template Context="context">
                                @{
                                    var item = (CartItem)context;
                                }
                                <div style="display:flex;align-items:center;gap:10px">
                                    <img src="@item.ImageUrl"
                                         style="height:50px;width:50px;object-fit:cover" />
                                    <span>@item.ProductName</span>
                                </div>
                            </Template>
                        </GridColumn>

                        <!-- Price -->
                        <GridColumn HeaderText="Price" Width="100">
                            <Template Context="context">
                                @{
                                    var item = (CartItem)context;
                                }
                                @item.UnitPrice.ToString("C")
                            </Template>
                        </GridColumn>

                        <!-- Quantity -->
                        <GridColumn HeaderText="Qty" Width="150">
                            <Template Context="context">
                                @{
                                    var item = (CartItem)context;
                                }
                                <div style="display:flex;align-items:center;gap:5px">
                                    <SfButton Content="−"
                                              CssClass="e-outline e-small"
                                              OnClick="@(() => Decrease(item))" />
                                    <span style="min-width:25px;text-align:center">
                                        @item.Quantity
                                    </span>
                                    <SfButton Content="+"
                                              CssClass="e-outline e-small"
                                              OnClick="@(() => Increase(item))" />
                                </div>
                            </Template>
                        </GridColumn>

                        <!-- Subtotal -->
                        <GridColumn HeaderText="Subtotal" Width="120">
                            <Template Context="context">
                                @{
                                    var item = (CartItem)context;
                                }
                                <strong>@item.Subtotal.ToString("C")</strong>
                            </Template>
                        </GridColumn>

                        <!-- Remove -->
                        <GridColumn HeaderText="" Width="100">
                            <Template Context="context">
                                @{
                                    var item = (CartItem)context;
                                }
                                <SfButton Content="Remove"
                                          CssClass="e-outline e-danger e-small"
                                          OnClick="@(() => Remove(item))" />
                            </Template>
                        </GridColumn>

                    </GridColumns>
                </SfGrid>
            }
        </div>

        <!-- Order Summary -->
        <div class="col-lg-4">
            <SfCard>
                <CardHeader><h5>Order Summary</h5></CardHeader>
                <CardContent>
                    <div style="display:flex;justify-content:space-between">
                        <span>Items (@CartService.ItemCount)</span>
                        <span>@CartService.Total.ToString("C")</span>
                    </div>
                </CardContent>
            </SfCard>
        </div>
    </div>
</div>

@code {
    private void Increase(CartItem item)
        => CartService.UpdateQuantity(item.ProductId, item.Quantity + 1);

    private void Decrease(CartItem item)
        => CartService.UpdateQuantity(item.ProductId, item.Quantity - 1);

    private void Remove(CartItem item)
        => CartService.RemoveItem(item.ProductId);
        
  protected override void OnInitialized()
    {
        CartService.OnCartChanged += CartChanged;
    }

    private void CartChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        CartService.OnCartChanged -= CartChanged;
    }

}