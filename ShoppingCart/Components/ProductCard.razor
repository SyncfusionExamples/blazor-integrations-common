<SfCard CssClass="h-100 shadow-sm">

    <CardContent>
        <img src="@Product.ImageUrl"
             class="img-fluid mb-2"
             alt="@Product.Name"
             style="height:200px; object-fit:cover" />

        <h5>@Product.Name</h5>
        <p class="text-muted small">@Product.Description</p>

        <span class="badge bg-warning text-dark">
            ⭐ @Product.Rating (@Product.ReviewCount)
        </span>

        <h5 class="text-primary mt-2">
            @Product.Price.ToString("C")
        </h5>
    </CardContent>

    <CardFooter>
        @if (Product.IsInStock)
        {
            <SfButton Content="Add to Cart"
                      CssClass="e-primary e-block w-100"
                      OnClick="() => OnAddToCart.InvokeAsync(Product)" />
        }
        else
        {
            <SfButton Content="Out of Stock"
                      Disabled="true"
                      CssClass="e-secondary e-block w-100" />
        }
    </CardFooter>

</SfCard>

@code {
    [Parameter] public Product Product { get; set; } = null!;
    [Parameter] public EventCallback<Product> OnAddToCart { get; set; }
}


