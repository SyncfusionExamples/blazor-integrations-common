@using ShoppingCart.Models
@using ShoppingCart.Services
@using ShoppingCart
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Inputs
@inject IWishlistService WishlistService

<SfCard CssClass="product-card h-100">

    <CardContent>
        <h6 class="fw-bold">@Item.Name</h6>

        <SfRating Value="@Item.Rating"
                  ReadOnly="true" />

        <p class="small text-muted">
            @Item.Description
        </p>
    </CardContent>

    <CardFooter>
        <div class="footer-row">
            <!-- LEFT: Price -->
            <span class="price">
                @Item.Price.ToString("C")
            </span>

            <!-- RIGHT: Actions -->
            <div class="footer-actions">
                <SfButton Content="Add"
                          CssClass="e-outline e-primary e-small"
                          Disabled="@(!Item.IsInStock)"
                          OnClick="() => OnAddToCart.InvokeAsync(Item)" />

                <!-- ❤️ Wishlist Heart -->
                <SfButton CssClass="e-outline e-small wishlist-btn"
                          Content="@HeartIcon"
                          OnClick="ToggleWishlist" />
            </div>
        </div>
    </CardFooter>
</SfCard>

@code {
    [Parameter] public Product Item { get; set; } = default!;
    [Parameter] public EventCallback<Product> OnAddToCart { get; set; }

    private string HeartIcon =>
        WishlistService.Contains(Item) ? "♥" : "♡";

    private void ToggleWishlist()
        => WishlistService.Toggle(Item);
}
<style>
    .product-card {
    border-radius: 10px;
    transition: box-shadow 0.2s ease;
}

.product-card:hover {
    box-shadow: 0 6px 16px rgba(0,0,0,0.08);
}

.product-image {
    height: 150px;
    background: #f4f6f8;
    display: flex;
    align-items: center;
    justify-content: center;
}

.card-img {
    max-height: 100%;
    max-width: 100%;
    object-fit: contain;
}


.footer-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.footer-actions {
    display: flex;
    gap: 6px;
}

.price {
    font-weight: 700;
}

.wishlist-btn {
    font-size: 16px;
    color: crimson;
}


</style>
