@inherits LayoutComponentBase

@inject NavigationManager UriHelper
@using AppointmentPlanner.Data;
@using AppointmentPlanner.Models;
@using Microsoft.JSInterop;
@inject IJSRuntime JSRuntime;

<div class="sb-content-overlay @(hide)">
    <div class="sb-loading">
        <svg class="circular" height="40" width="40">
            <circle class="path" cx="25" cy="25" r="20" fill="none" stroke-width="6" stroke-miterlimit="10" />
        </svg>
    </div>
    <div class="sb-caption">
        <h4 class="my-4">Appointment planner initializing...</h4>
    </div>
</div>
<div class="planner-wrapper" style="width: 100%; visibility:@(visible); opacity:@(opacity)">
    <div class="planner-header">
        <SfAppBar ColorMode="AppBarColor.Primary" CssClass="custom-appbar">
            <div class="side-bar-opener">
                <button type="button" class="open-icon e-icons" aria-label="@(open ? "Close navigation" : "Open navigation")" aria-expanded="@open" aria-controls="plannerSiderBar" @onclick="@showSideBar"></button>
            </div>
            <div class="name-cantainer">
                <span class="clinic-image icon-logo"></span>
                <div class="clinic-name appointment-title" role="img" aria-label="Appointment Planner">APPOINTMENT PLANNER</div>
            </div>
            <AppBarSpacer></AppBarSpacer>
            <button type="button" class="logout-container" aria-label="Logout" aria-haspopup="dialog" @onclick="OnLogoutClick">
                <span class="logout-icon-container"><span class="icon-logout logout-image" aria-hidden="true"></span></span>
                <span class='logout-name'>Logout</span>
            </button>
            <div class="sb-header-item sb-table-cell sb-download-wrapper">
                <a href="https://github.com/syncfusion/ej2-showcase-blazor-appointment-planner" target="_blank">
                    <div id="github" class="sb-github-btn">
                        <div class="github-image">
                            <img src="css/appoinment/mark.svg" alt="github" />
                        </div>
                    </div>
                </a>
            </div>
        </SfAppBar>
    </div>
    <SfSidebar ID="plannerSiderBar" EnableGestures="false" @bind-IsOpen="open" MediaQuery="(min-width: 701px)" Type="SidebarType.Auto" Created="OnCreate" CloseOnDocumentClick="onDocumentClick">
        <ChildContent>
            <div class="dock">
                <div class="info align-center">
                    <div class="image"><img src="css/appoinment/assets/images/Admin.png" alt="Admin" /></div>
                    <div class="content nameContent">
                        <p class='name'>Jane Doe</p>
                        <p class='user-type'>Admin</p>
                    </div>
                </div>
                <div class="sideparent menulist">
                    <ul class="nav flex-column">
                        <li class="nav-item e-list-item">
                            <NavLink class="nav-link sidebar-item" href="" Match="NavLinkMatch.All" @onclick="@CloseSidePane">
                                <span class="dashboard-image">
                                    <span class="item-image icon-dashboard"></span>
                                </span>
                                <span class="text" title="Dashboard">Dashboard</span>
                            </NavLink>
                        </li>
                        <li class="nav-item e-list-item">
                            <NavLink class="nav-link sidebar-item" href="schedule" @onclick="@CloseSidePane">
                                <span class="dashboard-image">
                                    <span class="item-image icon-schedule"></span>
                                </span>
                                <span class="text" title="Schedule">Schedule</span>
                            </NavLink>
                        </li>
                        <li class="nav-item e-list-item">
                            <NavLink class="nav-link sidebar-item" href="doctors" @onclick="@CloseSidePane">
                                <span class="dashboard-image">
                                    <span class="item-image icon-doctors"></span>
                                </span>
                                <span class="text" title="Doctors">Doctors</span>
                            </NavLink>
                        </li>
                        <li class="nav-item e-list-item">
                            <NavLink class="nav-link sidebar-item" href="patients" @onclick="@CloseSidePane">
                                <span class="dashboard-image">
                                    <span class="item-image icon-patients"></span>
                                </span>
                                <span class="text" title="Patients">Patients</span>
                            </NavLink>
                        </li>
                        <li class="nav-item e-list-item">
                            <NavLink class="nav-link sidebar-item" href="preference" @onclick="@CloseSidePane">
                                <span class="dashboard-image">
                                    <span class="item-image icon-preference"></span>
                                </span>
                                <span class="text" title="Preference">Preference</span>
                            </NavLink>
                        </li>
                        <li class="nav-item e-list-item">
                            <NavLink class="nav-link sidebar-item" href="about" @onclick="@CloseSidePane">
                                <span class="dashboard-image">
                                    <span class="item-image icon-about"></span>
                                </span>
                                <span class="text" title="About">About</span>
                            </NavLink>
                        </li>
                    </ul>
                </div>
            </div>
        </ChildContent>
    </SfSidebar>
    <main class="main-content">
        @Body
    </main>
    <div class="footer">
        <div class="footer-container">
            <div class="footer-icon">
                <img class="footer-logo" src="Appointmentplanner.svg" alt="Appointment planner" />
            </div>
            <div class="footer-content">
                <div class="title">
                    <span>Want an interactive appointment planner in your app?</span>
                    <span><strong> Try our Appointment Planner showcase sample</strong> — build, connect, and customize!</span>
                </div>
                <div class="buttons">
                    <a href="https://www.syncfusion.com/downloads/blazor?tag=es-seo-blazor-demos-static-menu-trial" target="_blank" class="e-trial-btn e-btn" title="Free Trial Button" role="button">Start Free Trial</a>
                    <a href="https://www.syncfusion.com/request-demo?tag=blazor-server-appointment-planner-showcase" target="_blank" class="e-demo-btn e-btn" title="Request Demo Button">Request Demo</a>
                </div>
            </div>
        </div>
    </div>
</div>

<SfDialog Target=".planner-wrapper" @bind-Visible="@showLogoutConfirm" IsModal="true" Width="360px" CssClass="logout-confirm-dialog" ShowCloseIcon="true" Header="Confirm logout">
    <ChildContent>
        <p class="logout-confirm-text">Are you sure you want to log out of the Appointment Planner? You will return to the Dashboard.</p>
        <div class="e-footer-content">
            <button type="button" class="e-btn e-normal" @onclick="@CancelLogout">Cancel</button>
            <button type="button" class="e-btn e-primary" @onclick="@ConfirmLogout">Log out</button>
        </div>
    </ChildContent>
</SfDialog>

@code{
    [Inject]
    protected AppointmentService Service { get; set; }
    [Inject]
    protected IJSRuntime JsRuntime { get; set; }
    [Inject]
    protected NavigationManager NavManager { get; set; }

    private bool onDocumentClick { get; set; }
    private bool isDevice { get; set; }

    private string target { get; set; } = "#loader-content";

    private string visible { get; set; } = "hidden";
    private string OverlayClass { get; set; }

    private string hide { get; set; }
    private string opacity { get; set; } = "0";
    private bool open { get; set; }
    private bool hasInitialized { get; set; }
    private bool showLogoutConfirm { get; set; }
    private List<NavigationMenu> navigationItems { get; set; }

    private void CloseSidePane()
    {
        if(this.isDevice){
            open = false;
        }
    }

    public void OnCreate()
    {
        // The SfSidebar Created event fires on every navigation because the
        // layout re-renders for each route. Only run the initial-load reveal
        // sequence once so subsequent navigations are not blocked by the overlay.
        if (this.hasInitialized)
        {
            return;
        }
        this.hasInitialized = true;
        this.hide = "sb-hide";
        this.visible = "visible";
        this.opacity = "1";
    }

    protected override void OnInitialized()
    {
        this.navigationItems = Service.NavigationMenu;
        // Ensure content is visible immediately for all navigations after the
        // first load, even if the sidebar OnCreate handler is not invoked.
        if (this.hasInitialized)
        {
            this.hide = "sb-hide";
            this.visible = "visible";
            this.opacity = "1";
        }
    }

    protected async override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var browserDevice = await JSRuntime.InvokeAsync<bool>("checkBrowserDevice");
            var viewportWidth = await JSRuntime.InvokeAsync<int>("getViewportWidth");
            this.isDevice = browserDevice || viewportWidth <= 700;
            this.onDocumentClick = this.isDevice;
            if (this.isDevice)
            {
                this.open = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private void showSideBar()
    {
        open = true;
    }

    private void OnLogoutClick()
    {
        showLogoutConfirm = true;
    }

    private void ConfirmLogout()
    {
        // Showcase sample: there is no real authentication store, so we return
        // the user to the Dashboard as the "logged out" landing view.
        showLogoutConfirm = false;
        NavManager.NavigateTo("dashboard", forceLoad: true);
    }

    private void CancelLogout()
    {
        showLogoutConfirm = false;
    }
}
