@page "/preference"

@using AppointmentPlanner.Data;
@using AppointmentPlanner.Models;

@if (isDataLoaded)
{
<div id="preference" class='preference-container'>
    <header>
        <div class="module-title">
            <h1 class='title'>Preferences</h1>
            <div class='underline'></div>
        </div>
        <p class="preference-intro">Tune the calendar for the way your clinic works.</p>
        <div class="preference-actions">
            <SfButton CssClass="e-normal" @onclick="@resetPreferences">Reset defaults</SfButton>
            <SfButton IsPrimary="true" @onclick="@savePreferences" Disabled="@(!IsConfigurationValid)">Save preferences</SfButton>
        </div>
    </header>
    @if (!string.IsNullOrWhiteSpace(settingsMessage))
    {
        <SfMessage Severity="@settingsMessageSeverity">@settingsMessage</SfMessage>
    }
    <div class="active-preferences" aria-live="polite">
        <div class="active-heading"><span class="e-icons e-check"></span><div><strong>Active configuration</strong><span>These values will be used by Schedule after saving.</span></div></div>
        <div class="configuration-values">
            <div><span class="summary-label">View</span><strong>@selectedView</strong></div>
            <div><span class="summary-label">First day</span><strong>@getDayOfWeekText()</strong></div>
            <div><span class="summary-label">Hours</span><strong>@selectedStartHour - @selectedEndHour</strong></div>
            <div><span class="summary-label">Slots</span><strong>@timeInterval min</strong></div>
            <div><span class="summary-label">Color by</span><strong>@selectedCategory</strong></div>
        </div>
    </div>
    <div class="preference-section">
        <div class="section-heading">
            <span class="section-icon e-icons e-settings"></span>
            <div><h2>Calendar display</h2><p>Choose how the schedule opens each day.</p></div>
        </div>
        <div class="control-container">
        <div class='label-text'>Default View</div>
        <SfDropDownList CssClass='preference-drop-down' ID='CurrentView' aria-label="Default View" @bind-Value="@selectedView" Width="335px" DataSource="@views">
            <DropDownListEvents TItem="TextValueData" TValue="string" ValueChange="onViewChange"></DropDownListEvents>
            <DropDownListFieldSettings Text="Text" Value="Value"></DropDownListFieldSettings>
        </SfDropDownList>
        </div>
        <div class="control-container">
        <div class='label-text'>First Day of the Week</div>
        <SfDropDownList CssClass='preference-drop-down' ID='FirstDayOfWeek' aria-label="First Day of the Week" @bind-Value="@selectedDayOfWeek" Width="335px" DataSource="@dayOfWeeks">
            <DropDownListEvents TItem="TextValueNumericData" TValue="int?" ValueChange="onFirstDayChange"></DropDownListEvents>
            <DropDownListFieldSettings Text="Text" Value="Value"></DropDownListFieldSettings>
        </SfDropDownList>
        </div>
    </div>
    <div class="preference-section">
        <div class="section-heading"><span class="section-icon e-icons e-clock"></span><div><h2>Working hours</h2><p>Set the visible clinic hours and booking rhythm.</p></div></div>
        <div class="control-container">
        <div class='label-text'>Calendar Start Time</div>
        <SfDropDownList CssClass='preference-drop-down' ID='CalendarStart' aria-label="Calendar Start Time" @bind-Value="@selectedStartHour" Width="335px" DataSource="@startHours">
            <DropDownListEvents TItem="TextValueData" TValue="string" ValueChange="onStartHourChange"></DropDownListEvents>
            <DropDownListFieldSettings Text="Text" Value="Value"></DropDownListFieldSettings>
        </SfDropDownList>
        </div>
        <div class="control-container">
        <div class='label-text'>Calendar End Time</div>
        <SfDropDownList CssClass='preference-drop-down' ID='CalendarEnd' aria-label="Calendar End Time" @bind-Value="@selectedEndHour" Width="335px" DataSource="@endHours">
            <DropDownListEvents TItem="TextValueData" TValue="string" ValueChange="onEndhourChange"></DropDownListEvents>
            <DropDownListFieldSettings Text="Text" Value="Value"></DropDownListFieldSettings>
        </SfDropDownList>
        </div>
        @if (!IsWorkingHoursValid)
        {
            <div class="preference-validation" role="alert">Calendar end time must be later than the start time.</div>
        }
        <div class="control-container">
        <div class='label-text'>Slot Duration</div>
        <SfDropDownList CssClass='preference-drop-down' ID='Duration' aria-label="Slot Duration" @bind-Value="@timeInterval" Width="335px" DataSource="@timeSlots">
            <DropDownListEvents TItem="TextValueNumericData" TValue="int?" ValueChange="onDurationChange"></DropDownListEvents>
            <DropDownListFieldSettings Text="Text" Value="Value"></DropDownListFieldSettings>
        </SfDropDownList>
        </div>
    </div>
    <div class="preference-section">
        <div class="section-heading"><span class="section-icon e-icons e-palette"></span><div><h2>Appointment appearance</h2><p>Choose how resources are distinguished on the schedule.</p></div></div>
        <div class="control-container">
        <div class='label-text'>Booking Color</div>
        <SfDropDownList CssClass='preference-drop-down' ID='BookingColor' aria-label="Booking Color" @bind-Value="@selectedCategory" Width="335px" DataSource="@colorCategory">
            <DropDownListEvents TItem="TextValueData" TValue="string" ValueChange="onColorChange"></DropDownListEvents>
            <DropDownListFieldSettings Text="Text" Value="Value"></DropDownListFieldSettings>
        </SfDropDownList>
        </div>
    </div>
</div>
}
else
{
    <div class="planner-preference-skeleton">
        <div class="preference-container1">
            <SfSkeleton Shape="Syncfusion.Blazor.Notifications.SkeletonType.Rectangle" Height="15px" Width="97%"></SfSkeleton>
            <br/>
            <SfSkeleton Shape="Syncfusion.Blazor.Notifications.SkeletonType.Rectangle" Height="15px" Width="74%"></SfSkeleton>
        </div>
        <div class="preference-container2">
            @for(int i=0; i<6; i++){
                <SfSkeleton Shape="Syncfusion.Blazor.Notifications.SkeletonType.Rectangle" Height="15px" Width="12%"></SfSkeleton>
                <br/>
                <SfSkeleton Shape="Syncfusion.Blazor.Notifications.SkeletonType.Rectangle" Height="15px" Width="35%"></SfSkeleton>
                <br/><br/>
            }
        </div>
    </div>
}

@code{
    [Inject]
    protected AppointmentService Service { get; set; }
    private List<TextValueData> views { get; set; }
    private List<TextValueData> startHours { get; set; }
    private List<TextValueData> endHours { get; set; }
    private List<TextValueNumericData> timeSlots { get; set; }
    private List<TextValueData> colorCategory { get; set; }
    private List<TextValueNumericData> dayOfWeeks { get; set; }
    private string selectedView { get; set; }
    private string selectedStartHour { get; set; }
    private string selectedEndHour { get; set; }
    private string selectedCategory { get; set; }
    private int? timeInterval { get; set; }
    private int? selectedDayOfWeek { get; set; }
    private bool isDataLoaded;
    private string settingsMessage;
    private MessageSeverity settingsMessageSeverity = MessageSeverity.Info;

    private bool IsWorkingHoursValid =>
        TimeSpan.TryParse(selectedStartHour, out var start) &&
        TimeSpan.TryParse(selectedEndHour, out var end) && start < end;

    private bool IsConfigurationValid => IsWorkingHoursValid && timeInterval.HasValue && timeInterval.Value > 0;

    private string getDayOfWeekText()
    {
        return dayOfWeeks?.FirstOrDefault(day => day.Value == selectedDayOfWeek)?.Text ?? "Sunday";
    }

    protected override void OnInitialized()
    {
        this.views = Service.Views;
        this.startHours = Service.StartHours;
        this.endHours = Service.EndHours;
        this.timeSlots = Service.TimeSlot;
        this.colorCategory = Service.ColorCategory;
    }

    private void onViewChange(Syncfusion.Blazor.DropDowns.ChangeEventArgs<string, TextValueData> args)
    {
        selectedView = args.Value;
    }
    private void onStartHourChange(Syncfusion.Blazor.DropDowns.ChangeEventArgs<string, TextValueData> args)
    {
        selectedStartHour = args.Value;
    }
    private void onEndhourChange(Syncfusion.Blazor.DropDowns.ChangeEventArgs<string, TextValueData> args)
    {
        selectedEndHour = args.Value;
    }
    private void onColorChange(Syncfusion.Blazor.DropDowns.ChangeEventArgs<string, TextValueData> args)
    {
        selectedCategory = args.Value;
    }
    private void onDurationChange(Syncfusion.Blazor.DropDowns.ChangeEventArgs<int?, TextValueNumericData> args)
    {
        timeInterval = args.Value;
    }
    private void onFirstDayChange(Syncfusion.Blazor.DropDowns.ChangeEventArgs<int?, TextValueNumericData> args)
    {
        selectedDayOfWeek = args.Value;
    }

    private void savePreferences(Microsoft.AspNetCore.Components.Web.MouseEventArgs args)
    {
        if (!IsConfigurationValid)
        {
            settingsMessageSeverity = MessageSeverity.Error;
            settingsMessage = "Review the calendar hours and slot duration before saving.";
            return;
        }

        Service.CalendarSettings.CurrentView = selectedView;
        Service.CalendarSettings.Calendar.Start = selectedStartHour;
        Service.CalendarSettings.Calendar.End = selectedEndHour;
        Service.CalendarSettings.Interval = timeInterval.Value;
        Service.CalendarSettings.BookingColor = selectedCategory;
        Service.CalendarSettings.FirstDayOfWeek = selectedDayOfWeek ?? 0;
        settingsMessageSeverity = MessageSeverity.Success;
        settingsMessage = "Preferences saved. Open Schedule to use the updated calendar settings.";
    }

    private void resetPreferences(Microsoft.AspNetCore.Components.Web.MouseEventArgs args)
    {
        selectedView = "Week";
        selectedStartHour = "08:00";
        selectedEndHour = "21:00";
        timeInterval = 60;
        selectedCategory = "Doctors";
        selectedDayOfWeek = 0;
        settingsMessageSeverity = MessageSeverity.Info;
        settingsMessage = "Default preferences restored. Select Save preferences to apply them.";
    }

    private async Task LoadData()
    {
        this.dayOfWeeks = Service.DayOfWeekList;
        this.selectedView = Service.CalendarSettings.CurrentView;
        this.selectedStartHour = Service.CalendarSettings.Calendar.Start;
        this.selectedEndHour = Service.CalendarSettings.Calendar.End;
        this.selectedCategory = Service.CalendarSettings.BookingColor;
        this.timeInterval = Service.CalendarSettings.Interval;
        this.selectedDayOfWeek = Service.CalendarSettings.FirstDayOfWeek;
        await Task.Delay(500);
        isDataLoaded = true;
        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadData();
        }
    }
}