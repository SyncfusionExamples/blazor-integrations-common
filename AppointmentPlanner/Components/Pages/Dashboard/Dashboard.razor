    // ---- Build dynamic datasets from service ----
    private void BuildPatients()
    {
        if (Service?.Patients == null) return;

        var weekStart = Today.AddDays(-(int)Today.DayOfWeek + (int)DayOfWeek.Monday);
        var rng = new Random(Today.Year * 100 + (int)Today.DayOfWeek + Service.Patients.Count);

        allPatients = Service.Patients.Select((p, idx) =>
        {
            int dayOffset;
            if (idx < 3)            dayOffset = -7 + (idx % 7);
            else if (idx < 21)      dayOffset = (idx - 3) % 7;
            else                    dayOffset = 7 + (idx % 5);

            var apptDate = weekStart.AddDays(dayOffset)
                                    .AddHours(9 + (p.Id % 8))
                                    .AddMinutes((p.Id * 13) % 60);
            return new PatientRow
            {
                Name = p.Name,
                Initial = GetInitials(p.Name),
                Age = GetAge(p.DOB),
                AppointmentDate = apptDate,
                DateTime = apptDate.ToString("d MMM yyyy · h:mm tt"),
                Reason = p.Disease
            };
        }).ToList();
    }

    private void BuildDailyAppointments()
    {
        if (Service?.Hospitals == null) return;
        var byDow = Service.Hospitals
            .GroupBy(h => h.StartTime.DayOfWeek)
            .ToDictionary(g => g.Key, g => g.Count());

        var order = new[]
        {
            DayOfWeek.Saturday, DayOfWeek.Sunday, DayOfWeek.Monday, DayOfWeek.Tuesday,
            DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday
        };
        var labels = new[] { "Sat", "Sun", "Mon", "Tue", "Wed", "Thu", "Fri" };

        dailyAppointments = order.Select((dow, i) =>
        {
            var total = byDow.TryGetValue(dow, out var c) ? c : 0;
            var clinic = Math.Round(total * 0.6, 0);
            var online = total - clinic;
            return new DayAppt { Day = labels[i], Clinic = clinic, Online = online };
        }).ToList();
    }

    private void BuildAppointmentTrend()
    {
        if (Service?.Hospitals == null) return;
        var byDow = Service.Hospitals
            .GroupBy(h => h.StartTime.DayOfWeek)
            .ToDictionary(g => g.Key, g => g.Count());

        var order = new[]
        {
            DayOfWeek.Saturday, DayOfWeek.Sunday, DayOfWeek.Monday, DayOfWeek.Tuesday,
            DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday
        };
        var labels = new[] { "Sat", "Sun", "Mon", "Tue", "Wed", "Thu", "Fri" };

        appointmentTrend = order.Select((dow, i) => new DayPoint
        {
            Day = labels[i],
            Value = byDow.TryGetValue(dow, out var c) ? c : 0
        }).ToList();
    }

    private void BuildDonut()
    {
        if (Service?.Patients == null) return;
        var groups = Service.Patients
            .GroupBy(p => GetAgeBucket(GetAge(p.DOB)))
            .ToDictionary(g => g.Key, g => g.Count());

        var palette = new (string Cat, string Color)[]
        {
            ("Child",  "#0a8a8a"),
            ("Teen",   "#f59e0b"),
            ("Adult",  "#ec4899"),
            ("Older",  "#a855f7"),
        };
        donutData = palette.Select(p => new DonutSlice
        {
            Category = p.Cat,
            Color = p.Color,
            Value = groups.TryGetValue(p.Cat, out var c) ? c : 0
        }).ToList();

        if (donutTotal == 0)
        {
            donutData = palette.Select(p => new DonutSlice
            {
                Category = p.Cat,
                Color = p.Color,
                Value = 1
            }).ToList();
        }
    }

    // ---- Helpers ----
    private int GetAge(DateTime? dob)
    {
        if (!dob.HasValue) return 0;
        var age = Today.Year - dob.Value.Year;
        if (dob.Value.Date > Today.AddYears(-age)) age--;
        return Math.Max(0, age);
    }

    private string GetAgeBucket(int age) => age switch
    {
        <= 12 => "Child",
        <= 19 => "Teen",
        <= 39 => "Adult",
        _ => "Older"
    };

    private string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpperInvariant();
        return (parts[0][0].ToString() + parts[1][0].ToString()).ToUpperInvariant();
    }

    private string FormatCount(int n)
    {
        if (n >= 1000) return (n / 1000.0).ToString("0.#") + "K";
        return n.ToString();
    }

    private double NiceMax(double v)
    {
        if (v <= 0) return 10;
        var pow = Math.Pow(10, Math.Floor(Math.Log10(v)));
        var n = v / pow;
        double nice = n <= 1 ? 1 : n <= 2 ? 2 : n <= 5 ? 5 : 10;
        return nice * pow;
    }

     private string GetStatus(PatientRow row)
        {
            if (row == null)
                return "Waiting";

            if (row.Age >= 65)
                return "Critical";

            if (row.Age >= 40)
                return "Moderate";

            return "Waiting";
        }

        private string GetStatusClass(PatientRow row)
        {
            if (row == null)
                return "waiting-chip";

            if (row.Age >= 65)
                return "critical-chip";

            if (row.Age >= 40)
                return "warning-chip";

            return "waiting-chip";
        }

        private string GetPriority(PatientRow row)
        {
            if (row == null) return "Normal";
            if (row.Age >= 65) return "Urgent";
            if (row.Age >= 40) return "High";
            return "Normal";
        }

        private string GetPriorityClass(PatientRow row)
        {
            if (row == null) return "priority-normal-chip";
            if (row.Age >= 65) return "priority-urgent-chip";
            if (row.Age >= 40) return "priority-high-chip";
            return "priority-normal-chip";
        }

    // ---- Lifecycle ----
    private bool isDataLoaded;
    //private SfGrid<PatientRow> grid;

    protected override void OnInitialized()
    {
        weekAnchor = Today.AddDays(-(int)Today.DayOfWeek + (int)DayOfWeek.Monday);
        BuildWeek();
        BuildWeekAppointments();
        BuildPatients();
        BuildDailyAppointments();
        BuildAppointmentTrend();
        BuildDonut();
        var firstFuture = weekDays.FindIndex(d => d.Date.Date >= Today.Date);
        selectedDayIndex = firstFuture < 0 ? 0 : firstFuture;
        SelectDay(selectedDayIndex);
    }

    protected async override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Task.Delay(120);
            isDataLoaded = true;
            StateHasChanged();
        }
    }

    public void Dispose() { }
