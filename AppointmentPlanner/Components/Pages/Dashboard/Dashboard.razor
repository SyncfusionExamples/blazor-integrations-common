    private Dictionary<DateTime, List<Hospital>> upcomingByDate = new();

    
    private void BuildWeekAppointments()
    {
        upcomingByDate = new Dictionary<DateTime, List<Hospital>>();
        if (Service?.Hospitals == null) return;

        foreach (var h in Service.Hospitals)
        {
            var date = h.StartTime.Date;
            if (!upcomingByDate.TryGetValue(date, out var list))
            {
                list = new List<Hospital>();
                upcomingByDate[date] = list;
            }
            list.Add(h);
        }
    }

    private List<Upcoming> GetUpcomingForDay(int idx)
    {
        if (Service?.Hospitals == null || weekDays.Count == 0) return new List<Upcoming>();

        var dayDate = weekDays[Math.Clamp(idx, 0, weekDays.Count - 1)].Date.Date;
        var docsById = Service.Doctors?.ToDictionary(d => d.Id) ?? new Dictionary<int, Doctor>();

        if (!upcomingByDate.TryGetValue(dayDate, out var matches) || matches == null)
            return new List<Upcoming>();

        return matches
            .OrderBy(h => h.StartTime)
            .Select(h =>
            {
                var doc = docsById.TryGetValue(h.DoctorId, out var d) ? d : null;
                var status = (doc?.Availability ?? "busy").ToLowerInvariant();
                return new Upcoming
                {
                    HospitalId = h.Id,
                    Name = h.Name,
                    Time = h.StartTime.ToString("h:mmtt").ToLower(),
                    Dept = h.DepartmentName,
                    StatusText = status == "available" ? "Online" : "Offline",
                    StatusClass = status == "available" ? "online" : "offline",
                    Initial = GetInitials(h.Name),
                    IsCheckedIn = checkedInUpcomingIds.Contains(h.Id) || completedUpcomingIds.Contains(h.Id)
                };
            }).ToList();
    }

    private void BuildWeek()
    {
        weekDays = Enumerable.Range(0, 7)
            .Select(i =>
            {
                var d = weekAnchor.AddDays(i);
                return new WeekDay { Short = d.ToString("ddd").Substring(0, 3), Number = d.Day, Date = d };
            })
            .ToList();
    }

    private void SelectDay(int idx)
    {
        selectedDayIndex = idx;
        upcomingAppointments = GetUpcomingForDay(idx);
    }

    private void PrevWeek()
    {
        var candidate = weekAnchor.AddDays(-7);
        if (candidate.AddDays(6).Date < Today.Date) return;
        weekAnchor = candidate;
        BuildWeek();
        BuildWeekAppointments();
        var firstFuture = weekDays.FindIndex(d => d.Date.Date >= Today.Date);
        SelectDay(firstFuture < 0 ? 0 : firstFuture);
    }

    private void NextWeek()
    {
        weekAnchor = weekAnchor.AddDays(7);
        BuildWeek();
        BuildWeekAppointments();
        SelectDay(0);
    }

