    private void BuildWeekAppointments()
    {
        _weekAppointments = new Dictionary<DateTime, List<Hospital>>();
        if (Service?.Hospitals == null) return;

        var weekStart = weekAnchor.Date;
        var ordered = Service.Hospitals.OrderBy(h => h.Id).ToList();
        int cursor = 0;

        for (int dayIndex = 0; dayIndex < 7; dayIndex++)
        {
            var day = weekStart.AddDays(dayIndex);
            var perDay = new List<Hospital>();
            int slots = 2 + (dayIndex % 2);
            for (int s = 0; s < slots; s++)
            {
                if (cursor >= ordered.Count) cursor = 0;
                var h = ordered[cursor++];
                var hour = 9 + ((h.Id + dayIndex) % 8);
                var minute = ((h.Id * 13) + (dayIndex * 17)) % 60;
                perDay.Add(new Hospital(
                    h.Id, h.Name,
                    day.AddHours(hour).AddMinutes(minute),
                    day.AddHours(hour).AddMinutes(minute).AddMinutes(30),
                    h.Disease, h.DepartmentName, h.DepartmentId, h.DoctorId, h.PatientId, h.Symptoms));
            }
            _weekAppointments[day] = perDay;
        }
    }

    private List<Upcoming> GetUpcomingForDay(int idx)
    {
        if (Service?.Hospitals == null || weekDays.Count == 0) return new List<Upcoming>();

        var dayDate = weekDays[Math.Clamp(idx, 0, weekDays.Count - 1)].Date;
        var docsById = Service.Doctors?.ToDictionary(d => d.Id) ?? new Dictionary<int, Doctor>();

        _weekAppointments.TryGetValue(dayDate, out var matches);
        matches = (matches ?? new List<Hospital>())
            .OrderBy(h => h.StartTime)
            .ToList();

        return matches.Select(h =>
        {
            var doc = docsById.TryGetValue(h.DoctorId, out var d) ? d : null;
            var status = (doc?.Availability ?? "busy").ToLowerInvariant();
            return new Upcoming
            {
                Name = h.Name,
                Time = h.StartTime.ToString("h:mmtt").ToLower(),
                Dept = h.DepartmentName,
                StatusText = status == "available" ? "Online" : "Offline",
                StatusClass = status == "available" ? "online" : "offline",
                Initial = GetInitials(h.Name)
            };
        }).ToList();
    }

