   private void BuildPatients()
    {
        if (Service?.Hospitals == null) { allPatients = new List<PatientRow>(); return; }

        var patientsById = Service.Patients?
            .GroupBy(p => p.Id)
            .ToDictionary(g => g.Key, g => g.First())
            ?? new Dictionary<int, Patient>();

        allPatients = Service.Hospitals
            .OrderBy(h => h.StartTime)
            .Select(h =>
            {
                patientsById.TryGetValue(h.PatientId, out var patient);
                var matched = patient ?? Service.Patients?.FirstOrDefault(p => p.Name == h.Name);
                return new PatientRow
                {
                    HospitalId = h.Id,
                    Name = h.Name,
                    Initial = GetInitials(h.Name),
                    Age = matched == null ? 0 : GetAge(matched.DOB),
                    AppointmentDate = h.StartTime,
                    DateTime = h.StartTime.ToString("d MMM yyyy · h:mm tt"),
                    Reason = h.Disease
                };
            })
            .ToList();
    }

    private readonly HashSet<int> checkedInUpcomingIds = new();
    private readonly HashSet<int> completedUpcomingIds = new();

    private void ApplyRowState(PatientRow row)
    {
        if (row == null) return;
        row.IsCheckedIn = checkedInUpcomingIds.Contains(row.HospitalId);
        row.IsCompleted = completedUpcomingIds.Contains(row.HospitalId);
    }

    private void BuildDailyAppointments()
    {
        if (Service?.Hospitals == null) return;
        var byDow = Service.Hospitals
            .GroupBy(h => h.StartTime.DayOfWeek)
            .ToDictionary(g => g.Key, g => g.Count());

        var order = new[]
        {
            DayOfWeek.Saturday, DayOfWeek.Sunday, DayOfWeek.Monday, DayOfWeek.Tuesday,
            DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday
        };
        var labels = new[] { "Sat", "Sun", "Mon", "Tue", "Wed", "Thu", "Fri" };

        dailyAppointments = order.Select((dow, i) =>
        {
            var total = byDow.TryGetValue(dow, out var c) ? c : 0;
            var clinic = Math.Round(total * 0.6, 0);
            var online = total - clinic;
            return new DayAppt { Day = labels[i], Clinic = clinic, Online = online };
        }).ToList();
    }

    private void BuildAppointmentTrend()
    {
        if (Service?.Hospitals == null) return;
        var byDow = Service.Hospitals
            .GroupBy(h => h.StartTime.DayOfWeek)
            .ToDictionary(g => g.Key, g => g.Count());

        var order = new[]
        {
            DayOfWeek.Saturday, DayOfWeek.Sunday, DayOfWeek.Monday, DayOfWeek.Tuesday,
            DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday
        };
        var labels = new[] { "Sat", "Sun", "Mon", "Tue", "Wed", "Thu", "Fri" };

        appointmentTrend = order.Select((dow, i) => new DayPoint
        {
            Day = labels[i],
            Value = byDow.TryGetValue(dow, out var c) ? c : 0
        }).ToList();
    }

    private void BuildDonut()
    {
        if (Service?.Patients == null) return;
        var groups = Service.Patients
            .GroupBy(p => GetAgeBucket(GetAge(p.DOB)))
            .ToDictionary(g => g.Key, g => g.Count());

        var palette = new (string Cat, string Color, string Rng)[]
        {
            ("Child",  "#0a8a8a", "0–12 yrs"),
            ("Teen",   "#f59e0b", "13–19 yrs"),
            ("Adult",  "#ec4899", "20–39 yrs"),
            ("Older",  "#a855f7", "40+ yrs"),
        };
        var temp = palette.Select(p => new DonutSlice
        {
            Category = p.Cat,
            Color = p.Color,
            AgeRange = p.Rng,
            Value = groups.TryGetValue(p.Cat, out var c) ? c : 0
        }).ToList();

       var total = temp.Sum(d => d.Value);
        foreach (var d in temp) d.Share = total > 0 ? (int)Math.Round(d.Value * 100.0 / total) : 0;
        donutData = temp;

        if (donutTotal == 0)
        {
           donutData = palette.Select(p => new DonutSlice
            {
