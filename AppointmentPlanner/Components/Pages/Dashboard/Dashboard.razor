    private void OnMonthPicked(DateTime? picked)
    {
        if (!picked.HasValue) { monthPickerOpen = false; return; }
        Today = picked.Value;
        monthPickerOpen = false;
        weekAnchor = Today.AddDays(-(int)Today.DayOfWeek + (int)DayOfWeek.Monday);
        BuildWeek();
        BuildWeekAppointments();
        BuildPatients();
        BuildDailyAppointments();
        BuildAppointmentTrend();
        BuildDonut();
        var firstFuture = weekDays.FindIndex(d => d.Date.Date >= Today.Date);
        SelectDay(firstFuture < 0 ? 0 : firstFuture);
    }

