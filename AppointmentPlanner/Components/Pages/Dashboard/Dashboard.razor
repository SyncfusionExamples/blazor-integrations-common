    private IEnumerable<PatientRow> filteredPatients
{
    get
    {
        // Start by filtering according to the selected dashboard tab.
        IEnumerable<PatientRow> q = activeTab switch
        {
            // -------------------------------------------------
            // DAILY
            // Only appointments for the currently selected date
            // -------------------------------------------------
            "Daily" => allPatients.Where(p =>
                p.AppointmentDate.Date == Today.Date),

            // -------------------------------------------------
            // WEEKLY
            // Appointments from Monday through Sunday
            // containing the selected Today date
            // -------------------------------------------------
            "Weekly" => allPatients.Where(p =>
                IsInCurrentWeek(p.AppointmentDate)),

            // -------------------------------------------------
            // MONTHLY
            // Appointments in the selected month/year
            // -------------------------------------------------
            "Monthly" => allPatients.Where(p =>
                p.AppointmentDate.Year == Today.Year &&
                p.AppointmentDate.Month == Today.Month),

            // -------------------------------------------------
            // YEARLY
            // Appointments in the selected year
            // -------------------------------------------------
            "Yearly" => allPatients.Where(p =>
                p.AppointmentDate.Year == Today.Year),

            // Safety fallback
            _ => allPatients
        };

        // =====================================================
        // SEARCH FILTER
        // Search both patient name and appointment reason.
        // =====================================================

        if (!string.IsNullOrWhiteSpace(searchText))
        {
            var search = searchText.Trim();

            q = q.Where(p =>
                (!string.IsNullOrWhiteSpace(p.Name) &&
                 p.Name.Contains(
                     search,
                     StringComparison.OrdinalIgnoreCase))
                ||
                (!string.IsNullOrWhiteSpace(p.Reason) &&
                 p.Reason.Contains(
                     search,
                     StringComparison.OrdinalIgnoreCase)));
        }

        // =====================================================
        // PRIORITY / SEVERITY FILTER
        // =====================================================

        if (!string.IsNullOrWhiteSpace(severityFilter))
        {
            q = severityFilter switch
            {
                "Critical" => q.Where(p =>
                    GetPriority(p) == "Urgent"),

                "Urgent" => q.Where(p =>
                    GetPriority(p) == "Urgent"),

                "High" => q.Where(p =>
                    GetPriority(p) == "High"),

                "Normal" => q.Where(p =>
                    GetPriority(p) == "Normal"),

                _ => q
            };
        }

        // =====================================================
        // ORDER RESULTS
        //
        // I recommend:
        // 1. Incomplete patients first
        // 2. Highest priority first
        // 3. Earliest appointment first
        // 4. Completed patients last
        // =====================================================

        var result = q
            .OrderBy(p => p.IsCompleted)
            .ThenByDescending(p => GetPriorityScore(p))
            .ThenBy(p => p.AppointmentDate)
            .ToList();

        // Apply check-in/completed state from your HashSets.
        foreach (var row in result)
        {
            ApplyRowState(row);
        }

        return result;
    }
}
