@page "/"
@page "/dashboard"

@using AppointmentPlanner.Data;
@using AppointmentPlanner.Models;
@using System;
@using System.Linq;
@using System.Text;
@using System.Threading;
@using Syncfusion.Blazor.InteractiveChat;
@implements IDisposable

@if (isDataLoaded)
{
    <div id="dashboard-modern" class="dashboard-container" @onclick="CloseMonthPicker">

        <!-- ============ Top header =========== -->
              <header class="page-header">
            <div class="page-title-wrap">
               <h6>Good Morning, Admin</h6>
                <span class="page-meta"><p class="page-meta-text">Last refreshed @lastUpdated · data updates live</p></span>
            </div>

            <div class="page-header-actions">
                <span class="global-search-wrap">
                    <span class="e-icons e-search search-icon" aria-hidden="true"></span>
                    <input type="text"
                           placeholder="Search patients, reasons…"
                           aria-label="Search patients or appointment reasons"
                           @bind="searchText"
                           @bind:event="oninput"
                           role="searchbox"
                           aria-describedby="search-help" />
                </span>
                <span id="search-help" style="display:none;">Filter patients and appointment reasons in real time</span>

                <button type="button"
                        class="ai-button"
                        aria-label="Open clinic assistant"
                        aria-expanded="@showAI"
                        @onclick="OpenAI">
                    <span class="e-icons e-assist" aria-hidden="true"></span>
                    Ask AI
                </button>
            </div>
        </header>
         @if (CriticalPatients > 0)
        {
            <div class="critical-banner" role="alert">
                <span class="banner-icon e-icons e-status-info" aria-hidden="true"></span>
                <div class="banner-text">
                    <strong>@CriticalPatients critical patient@(CriticalPatients == 1 ? "" : "s") need immediate attention</strong>
                    <span class="banner-meta">Last check @lastUpdated · highest priority first</span>
                </div>
                <button type="button" class="banner-cta" @onclick=@(() => { severityFilter = "Critical"; activeTab = "Daily"; })>Triage queue</button>
            </div>
        }


      <!-- ============ Primary CTA strip (P0: dashboard must be action-oriented) ============ -->
        <div class="cta-strip" role="toolbar" aria-label="Quick actions">
            <div class="cta-wrap" style="position:relative;">
                <button type="button" class="cta-primary" @onclick="StartNextConsultation">
                    <span class="e-icons e-plus" style="font-size:14px;" aria-hidden="true"></span>
                    Start next consultation
                </button>
            </div>
            <div class="cta-wrap" style="position:relative;">
                <button type="button" class="cta-secondary" aria-expanded="@showScheduleCalendar"
                        @onclick="ToggleScheduleCalendar">
                    <span class="e-icons e-icon-calendar" style="font-size:14px;" aria-hidden="true"></span>
                    Schedule appointment
                </button>

                @if (showScheduleCalendar)
                {
                    <div class="schedule-popup" role="dialog" aria-label="Pick a date for the appointment">
                        <div class="schedule-popup-head">Schedule on a date</div>
                        <SfCalendar TValue="DateTime?"
                                    Min="@calendarMin"
                                    Max="@calendarMax"
                                    Value="@Today">
                            <CalendarEvents TValue="DateTime?" ValueChange="OnScheduleDatePicked"></CalendarEvents>
                        </SfCalendar>
                    </div>
                }
            </div>
            <div class="cta-live" aria-live="polite">
                <span class="pulse-dot" aria-hidden="true"></span>
                <span>Live — @ConsultationCount doctors available</span>
            </div>
        </div>


        <!-- ============ Two-column hero: left = 4 KPI cards + 2 charts, right = Patient Overview ============ -->
        <div class="dash-hero">
            <div class="dash-hero-left">
                <!-- 4-card colored metric strip -->
                <div class="dashboard-kpi-strip">
                    <SfCard CssClass="modern-kpi" ID="active-patients-card">
                <CardContent>

                    <div class="kpi-header">
                        <span class="kpi-title">Active Patients</span>
                        <span class="kpi-icon kpi-patient" aria-hidden="true">
                            <span class="e-icons e-people"></span>
                        </span>
                    </div>

                    <div class="kpi-value" role="text" aria-label="Active patients: @totalPatients">@totalPatients</div>

                    <div class="kpi-trend @(totalPatientsTrend < 0 ? "negative" : totalPatientsTrend > 0 ? "positive" : "neutral")" title="vs previous week" aria-label="@(totalPatientsTrend < 0 ? "Down" : totalPatientsTrend > 0 ? "Up" : "No change") @Math.Abs(totalPatientsTrend)% this week">
                        @(totalPatientsTrend < 0 ? "↓" : totalPatientsTrend > 0 ? "↑" : "→") @Math.Abs(totalPatientsTrend)% <span class="kpi-trend-meta">this week</span>
                    </div>

                    <SfSparkline TValue="TrendPoint"
                                Height="45px"
                                DataSource="@patientSpark"
                                aria-label="Active patients trend, last 7 days">
                        <SparklineValueType ValueType="SparklineValueType.Numeric">
                        </SparklineValueType>
                    </SfSparkline>

                </CardContent>
            </SfCard>

            <SfCard CssClass="modern-kpi" ID="waiting-patients-card">
                <CardContent>

                    <div class="kpi-header">
                        <span class="kpi-title">Waiting</span>
                        <span class="kpi-icon kpi-waiting" aria-hidden="true">
                            <span class="e-icons e-clock"></span>
                        </span>
                    </div>

                    <div class="kpi-value" role="text" aria-label="Patients waiting: @WaitingCount">@WaitingCount</div>

                    <div class="kpi-trend @(WaitingCount == 0 ? "neutral" : "positive")">
                        @TotalPatientsInPeriod in active view
                    </div>

                    <div class="kpi-meter" role="img" aria-label="Waiting share of active view: @waitingShare%">
                        <span style="width:@(waitingShare)%"></span>
                    </div>

                </CardContent>
            </SfCard>

            <SfCard CssClass="modern-kpi" ID="doctors-available-card">
                <CardContent>

                    <div class="kpi-header">
                        <span class="kpi-title">Doctors Available</span>
                        <span class="kpi-icon kpi-available" aria-hidden="true">
                            <span class="e-icons e-user"></span>
                        </span>
                    </div>

                    <div class="kpi-value" role="text" aria-label="Doctors available: @ConsultationCount of @doctorCount">@ConsultationCount<span class="kpi-sub">/@doctorCount</span></div>

                    <div class="kpi-trend neutral">
                        @doctorUtilization% utilisation now
                    </div>

                    <div class="kpi-meter" role="img" aria-label="Doctor utilisation: @doctorUtilization%">
                        <span style="width:@(doctorUtilization)%"></span>
                    </div>

                </CardContent>
            </SfCard>

            <SfCard CssClass="modern-kpi" ID="completed-visits-card">
                <CardContent>

                    <div class="kpi-header">
                        <span class="kpi-title">Completed Visits</span>
                        <span class="kpi-icon kpi-completed" aria-hidden="true">
                            <span class="e-icons e-check"></span>
                        </span>
                    </div>

                    <div class="kpi-value" role="text" aria-label="Completed visits: @CompletedCount of @TotalPatientsInPeriod in active view">@CompletedCount<span class="kpi-sub">/@TotalPatientsInPeriod</span></div>

                    <div class="kpi-trend @(appointmentsTrend < 0 ? "negative" : appointmentsTrend > 0 ? "positive" : "neutral")" title="vs previous week" aria-label="@(appointmentsTrend < 0 ? "Down" : appointmentsTrend > 0 ? "Up" : "No change") @Math.Abs(appointmentsTrend)% throughput">
                        @(appointmentsTrend < 0 ? "↓" : appointmentsTrend > 0 ? "↑" : "→") @Math.Abs(appointmentsTrend)% <span class="kpi-trend-meta">throughput</span>
                    </div>

                    <div class="kpi-meter" role="img" aria-label="Completion rate: @completionRate%">
                        <span style="width:@(completionRate)%"></span>
                    </div>

                </CardContent>
            </SfCard>
                </div>

                <!-- Bar + Line charts row -->
                <div class="dash-row-2col">
                    <!-- Daily Appointment Stats (bar chart with tooltip) -->
                    <div class="dash-card">
                        <div class="dash-card-header">
                            <h3 class="dash-card-title">Daily Appointment Stats</h3>
                            <button class="dash-card-actions" title="More" aria-label="More">⋯</button>
                        </div>
                        <SfChart Height="220px" Width="100%">
                            <ChartArea><ChartAreaBorder Width="0"></ChartAreaBorder></ChartArea>
                            <ChartPrimaryXAxis ValueType="@Syncfusion.Blazor.Charts.ValueType.Category" Interval="1">
                                <ChartAxisMajorGridLines Width="0"></ChartAxisMajorGridLines>
                                <ChartAxisMajorTickLines Width="0"></ChartAxisMajorTickLines>
                                <ChartAxisLabelStyle Color="#94a3b8" Size="11px"></ChartAxisLabelStyle>
                            </ChartPrimaryXAxis>
                            <ChartPrimaryYAxis Minimum="0" Maximum="@dailyYMax" Interval="@dailyYInterval">
                                <ChartAxisMajorGridLines Color="#eef2f7" Width="1"></ChartAxisMajorGridLines>
                                <ChartAxisMajorTickLines Width="0"></ChartAxisMajorTickLines>
                                <ChartAxisLabelStyle Color="#94a3b8" Size="11px"></ChartAxisLabelStyle>
                            </ChartPrimaryYAxis>
                            <ChartLegendSettings Visible="true" Position="@Syncfusion.Blazor.Charts.LegendPosition.Top"
                                                 Alignment="Syncfusion.Blazor.Charts.Alignment.Center"></ChartLegendSettings>
                            <ChartSeriesCollection>
                                <ChartSeries DataSource="@dailyAppointments"
                                             Type="Syncfusion.Blazor.Charts.ChartSeriesType.Column"
                                             XName="Day" YName="Clinic" Name="Clinic"
                                             Fill="#0a8a8a" ColumnSpacing="0.35">
                                    <ChartCornerRadius TopLeft="6" TopRight="6"></ChartCornerRadius>
                                </ChartSeries>
                                <ChartSeries DataSource="@dailyAppointments"
                                             Type="Syncfusion.Blazor.Charts.ChartSeriesType.Column"
                                             XName="Day" YName="Online" Name="Online"
                                             Fill="#94a3b8" ColumnSpacing="0.35">
                                    <ChartCornerRadius TopLeft="6" TopRight="6"></ChartCornerRadius>
                                </ChartSeries>
                            </ChartSeriesCollection>
                        </SfChart>
                    </div>

                    <!-- Appointment Stats (line/spline) -->
                    <div class="dash-card">
                        <div class="dash-card-header">
                            <h3 class="dash-card-title">Appointment Stats</h3>
                            <button class="dash-card-actions" title="More" aria-label="More">⋯</button>
                        </div>
                        <SfChart height="100%" Width="100%">
                            <ChartArea><ChartAreaBorder Width="0"></ChartAreaBorder></ChartArea>
                            <ChartPrimaryXAxis ValueType="@Syncfusion.Blazor.Charts.ValueType.Category" Interval="1">
                                <ChartAxisMajorGridLines Width="0"></ChartAxisMajorGridLines>
                                <ChartAxisMajorTickLines Width="0"></ChartAxisMajorTickLines>
                                <ChartAxisLabelStyle Color="#94a3b8" Size="11px"></ChartAxisLabelStyle>
                            </ChartPrimaryXAxis>
                            <ChartPrimaryYAxis Minimum="0" Maximum="@trendYMax" Interval="@trendYInterval">
                                <ChartAxisMajorGridLines Color="#eef2f7" Width="1"></ChartAxisMajorGridLines>
                                <ChartAxisMajorTickLines Width="0"></ChartAxisMajorTickLines>
                                <ChartAxisLabelStyle Color="#94a3b8" Size="11px"></ChartAxisLabelStyle>
                            </ChartPrimaryYAxis>
                            <ChartLegendSettings Visible="false"></ChartLegendSettings>
                            <ChartSeriesCollection>
                                <ChartSeries DataSource="@appointmentTrend"
                                             Type="Syncfusion.Blazor.Charts.ChartSeriesType.Spline"
                                             XName="Day" YName="Value"
                                             Fill="#0a8a8a">
                                    <ChartSeriesBorder Width="3" Color="#0a8a8a"></ChartSeriesBorder>
                                    <ChartMarker Visible="true" Width="6" Height="6" Fill="#0a8a8a" Shape="Syncfusion.Blazor.Charts.ChartShape.Circle">
                                    </ChartMarker>
                                </ChartSeries>
                            </ChartSeriesCollection>
                        </SfChart>
                    </div>
                </div>
            </div>

            <!-- Right side: Patient Overview (spans both rows of the hero) -->
            <div class="dash-hero-right">
                <div class="dash-card donut-card">
                    <div class="dash-card-header">
                        <h3 class="dash-card-title">Patient Overview</h3>
                        <div class="donut-header-meta">
                            @if (dominantSegment != null)
                            {
                                <span class="donut-delta @(dominantShare >= 50 ? "down" : "")"
                                      title="Largest cohort">
                                    @dominantSegment.Category @dominantShare%
                                </span>
                            }
                            <button class="dash-card-actions" title="More" aria-label="More">⋯</button>
                        </div>
                    </div>
                    <div class="donut-wrap">
                        <SfAccumulationChart Width="100%" Height="100%">
                            <AccumulationChartSeriesCollection>
                                <AccumulationChartSeries
                                    DataSource="@donutData"
                                    XName="Category"
                                    YName="Value"
                                    InnerRadius="62%"
                                    Type="Syncfusion.Blazor.Charts.AccumulationType.Pie"
                                    PointColorMapping="Color"
                                    Explode="false">
                                    <AccumulationDataLabelSettings Visible="false"></AccumulationDataLabelSettings>
                                </AccumulationChartSeries>
                            </AccumulationChartSeriesCollection>
                            <AccumulationChartLegendSettings Visible="false"></AccumulationChartLegendSettings>
                        </SfAccumulationChart>
                        <div class="donut-center" aria-label="Total patients: @donutTotal">
                            <div class="donut-total">@donutTotal</div>
                            <div class="donut-sub">Patients</div>
                        </div>
                        @foreach (var seg in donutData)
                        {
                            var idx = donutData.IndexOf(seg);
                            var segShare = donutTotal > 0
                                ? (int)Math.Round(seg.Value * 100.0 / Math.Max(1, donutTotal))
                                : 0;
                            <div class="donut-label donut-label-@idx" style="color:@seg.Color"
                                 title="@seg.Category: @seg.Value patients (@segShare%)">
                                <span class="donut-num">@seg.Value</span>
                                <span class="donut-cat">@seg.Category</span>
                                <span class="donut-pct">@segShare%</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- ============ Bottom row: Patients table + Upcoming Appointments ============ -->
        <div class="dash-row-bottom">
            <div class="dash-card-grid">
                <div class="dash-card-header">
                    <h3 class="dash-card-title">Patients</h3>
                    <div class="dash-tabs" role="tablist" aria-label="Queue period">
                        @foreach (var t in patientTabs)
                        {
                            var tabName = t;
                            <button type="button" role="tab" aria-selected="@(activeTab == tabName)"
                                    class="dash-tab @(activeTab == tabName ? "active" : "")"
                                    @onclick="@(() => activeTab = tabName)">@tabName</button>
                        }
                    </div>
                </div>
                <div class="patients-grid">
                       @if (filteredPatients.Count() == 0)
                    {
                        <div class="patients-empty" role="status">
                            <strong>No patients in this @activeTab view.</strong><br />
                            Try switching the period tabs or <button type="button" class="link-btn" @onclick=@(() => severityFilter = null)>clear the severity filter</button>.
                        </div>
                    }
                    <SfGrid @ref="grid"
                            DataSource="@filteredPatients"
                            Height="340px"
                            Width="100%"
                            AllowPaging="false"
                            AllowSorting="true"
                            GridLines="Syncfusion.Blazor.Grids.GridLine.None"
                            RowHeight="52" AllowTextWrap="true">
                             
                        <GridColumns> 
                            <GridColumn Field="Name" HeaderText="Name"  Width="110" >
                                <Template>
                                    @{
                                        var row = (context as PatientRow);
                                    }
                                    <span class="pname">
                                        <span class="pavatar">@row.Initial</span>
                                        @row.Name
                                    </span>
                                </Template>
                            </GridColumn>
                            <GridColumn Field="Age" HeaderText="Age" Width="80" >
                                <Template>
                                    @{
                                        var row = (context as PatientRow);
                                    }
                                    @row.Age years
                                </Template>
                            </GridColumn>
                            <GridColumn Field="AppointmentDate" HeaderText="Date &amp; Time" Width="180" Format="d MMM yyyy · h:mm tt" Type="Syncfusion.Blazor.Grids.ColumnType.DateTime" />
                            <GridColumn Field="Reason" Width="120" HeaderText="Appointed For" />
                            <GridColumn HeaderText="Priority"  Width="100">
                                <Template>
                                    @{
                                        var prow = (context as PatientRow);
                                        var priorityText = GetPriority(prow);
                                    }
                                    <span class="@GetPriorityClass(prow)" title="@priorityText">@priorityText</span>
                                </Template>
                            </GridColumn>
                        <GridColumn HeaderText="Actions" Width="250">
                            <Template>
                                @{
                                    var arow = (context as PatientRow);
                                }
                                @if (arow.IsCompleted)
                                {
                                    <span class="status-done" title="This appointment is completed">Completed</span>
                                }
                                else if (arow.IsCheckedIn)
                                {
                                    <span class="status-checkedin" title="Patient is in consultation">In consultation</span>
                                    <button type="button" class="row-action-btn ghost"
                                            @onclick=@(() => CompletePatient(arow))
                                            aria-label="Mark @arow.Name as completed">Complete</button>
                                }
                                else
                                {
                                    <button type="button" class="row-action-btn"
                                            @onclick=@(() => CheckInPatient(arow))
                                            aria-label="Check in @arow.Name">Check In</button>
                                    <button type="button" class="row-action-btn ghost"
                                            @onclick=@(() => CompletePatient(arow))
                                            aria-label="Mark @arow.Name as completed">Complete</button>
                                }
                            </Template>
                        </GridColumn>
                        </GridColumns>
                    </SfGrid>
                </div>
            </div>

            <!-- Upcoming Appointments -->
            <div class="dash-card upcoming-card">
                <div class="dash-card-header">
                    <h3 class="dash-card-title">Upcoming Appointments</h3>
                    <div class="upcoming-month">
                        <button class="nav-btn" @onclick="PrevWeek" aria-label="Previous week">‹</button>
                        <span class="month-label">@currentMonthLabel</span>
                        <button class="nav-btn" @onclick="NextWeek" aria-label="Next week">›</button>
                    </div>
                </div>
                <div class="upcoming-week">
                    @{
                        var hasFutureDay = weekDays.Any(d => d.Date.Date >= Today.Date);
                    }
                    @if (!hasFutureDay)
                    {
                        <div class="upcoming-empty" style="grid-column: span 7;">No upcoming days in this week.</div>
                    }
                    else
                    {
                        @for (int i = 0; i < weekDays.Count; i++)
                        {
                            var dayIndex = i;
                            var d = weekDays[dayIndex];
                            var isPast = d.Date.Date < Today.Date;
                            if (isPast) continue;
                            <button class="day @(selectedDayIndex == dayIndex ? "selected" : "")"
                                    @onclick="@(() => SelectDay(dayIndex))"
                                    aria-label="@d.Short, @d.Number"
                                    aria-pressed="@(selectedDayIndex == dayIndex)">
                                @d.Short
                                <span class="dnum">@d.Number</span>
                            </button>
                        }
                    }
                </div>
                <div class="upcoming-list">
                    @if (upcomingAppointments.Count == 0)
                    {
                        <div class="upcoming-empty" role="status">
                            <strong>No appointments for this day.</strong>
                            Pick another day or use › to move to next week.
                        </div>
                    }
                    else
                    {
                        <ul class="upcoming-listview" role="list">
                            @for (var idx = 0; idx < upcomingAppointments.Count; idx++)
                            {
                                var a = upcomingAppointments[idx];
                                var itemKey = idx;
                                <li class="upcoming-item" key="@itemKey">
                                    <div class="uavatar" aria-hidden="true">@a.Initial</div>
                                    <div class="uinfo">
                                        <div class="uname">@a.Name</div>
                                        <div class="utime">@a.Time · @a.Dept</div>
                                    </div>
                                    <div class="appointment-actions">
                                        @if (a.IsCheckedIn)
                                        {
                                            <span class="checkedin-tag" title="Patient has been checked in">✓ Checked in</span>
                                        }
                                        else
                                        {
                                            <button type="button" class="row-action-btn"
                                                    @onclick="@(() => CheckInUpcoming(a))"
                                                    aria-label="Check in @a.Name for @a.Dept appointment">Check-In</button>
                                        }
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
    </div>
     <!-- Call feedback toast -->
    @if (callingName != null)
    {
        <div class="call-toast" role="status" aria-live="polite">
            <span class="e-icons e-phone" aria-hidden="true"></span>
            Connecting call to <strong>@callingName</strong>…
        </div>
    }
   @if (showAI)
{
    <div class="ai-overlay" @onclick="CloseAI"></div>

    <aside class="ai-assistant-panel"
           role="dialog"
           aria-modal="true"
           aria-labelledby="ai-assistant-title">

        <div class="ai-assistant-header">

            <div class="ai-assistant-heading">

                <div class="ai-assistant-logo" aria-hidden="true">
                    <span class="e-icons e-assist"></span>
                </div>

                <div class="ai-title-group">
                    <strong id="ai-assistant-title">
                        Clinic Assistant
                    </strong>

                    <span>
                        Ask about patients, queue or appointments
                    </span>
                </div>

            </div>

            <button type="button"
                    class="ai-panel-close"
                    aria-label="Close clinic assistant"
                    @onclick="CloseAI">
                ✕
            </button>

        </div>

        @if (!aiHasConversation)
        {
            <section class="ai-welcome">

                <div class="ai-welcome-icon">
                    <span class="e-icons e-assist"></span>
                </div>

                <h3>How can I help?</h3>

                <p>
                    Ask about the current clinic situation.
                    I can analyse the active queue, appointments
                    and available doctors.
                </p>

                <div class="ai-context-summary">

                    <div>
                        <strong>@WaitingCount</strong>
                        <span>Waiting</span>
                    </div>

                    <div>
                        <strong>@ConsultationCount</strong>
                        <span>Doctors available</span>
                    </div>

                    <div>
                        <strong>@CompletedCount</strong>
                        <span>Completed</span>
                    </div>

                </div>

                <div class="ai-question-label">
                    Try asking
                </div>

                <div class="ai-starter-grid">

                    <button type="button"
                            @onclick='() => AskSuggestion("Who should I see next?")'>

                        <span class="e-icons e-user ai-question-icon"></span>

                        <span class="ai-question-content">
                            <strong>Who should I see next?</strong>
                            <small>Prioritize the current queue</small>
                        </span>

                    </button>

                    <button type="button"
                            @onclick='() => AskSuggestion("Why is the queue high?")'>

                        <span class="e-icons e-clock ai-question-icon"></span>

                        <span class="ai-question-content">
                            <strong>Why is the queue high?</strong>
                            <small>Analyse current workload</small>
                        </span>

                    </button>

                    <button type="button"
                            @onclick='() => AskSuggestion("Show urgent patients")'>

                        <span class="e-icons e-warning ai-question-icon"></span>

                        <span class="ai-question-content">
                            <strong>Show urgent patients</strong>
                            <small>Find patients needing attention</small>
                        </span>

                    </button>

                    <button type="button"
                            @onclick='() => AskSuggestion("Find an available doctor")'>

                        <span class="e-icons e-people ai-question-icon"></span>

                        <span class="ai-question-content">
                            <strong>Find available doctor</strong>
                            <small>Check current capacity</small>
                        </span>

                    </button>

                </div>

            </section>
        }

        <div class="ai-chat-container @(aiHasConversation ? "conversation-active" : "")">

            <SfAIAssistView @ref="aiAssist"
                            PromptSuggestions="@aiPromptSuggestions"
                            PromptSuggestionsHeader="You may also ask"
                            PromptPlaceholder="Ask about today's clinic..."
                            PromptRequested="@OnAIRequest"
                            EnableScrollToBottom="true">
            </SfAIAssistView>

        </div>

        <div class="ai-disclaimer">
            <span class="e-icons e-circle-info"></span>
            Recommendations are based on dashboard data and should
            support, not replace, clinical judgement.
        </div>

    </aside>
}
}
else
{
    <div class="dash-skeleton">
        <div class="sk-row">
            <div class="sk-block"></div>
            <div class="sk-block"></div>
            <div class="sk-block"></div>
            <div class="sk-block"></div>
        </div>
    </div>
}

@code {

    [Inject]
    protected AppointmentService Service { get; set; }

    [Inject]
    protected NavigationManager Urihelper { get; set; }
    string lastUpdated => DateTime.Now.ToString("hh:mm:ss tt");
    private bool showAI;
    private bool aiHasConversation;

    private SfAIAssistView aiAssist;

    private readonly List<string> aiPromptSuggestions = new()
    {
        "Who should I see next?",
        "Show urgent patients",
        "Why is the queue high?",
        "Which doctors are available?",
