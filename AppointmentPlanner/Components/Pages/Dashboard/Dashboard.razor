    private string GetUrgentPatientsAnswer()
    {
        var urgentPatients = filteredPatients
            .Where(p => !p.IsCompleted)
            .Where(p => GetPriority(p) == "Urgent")
            .OrderBy(p => p.AppointmentDate)
            .Take(5)
            .ToList();

        if (urgentPatients.Count == 0)
        {
            return $"""
    ### No urgent patients

    There are currently **no urgent patients** in the **{activeTab}** view.

    There are **{WaitingCount} patient(s)** waiting overall.
    """;
        }

        var result = new StringBuilder();

        result.AppendLine("### Urgent patients");
        result.AppendLine();

        foreach (var patient in urgentPatients)
        {
            result.AppendLine(
                $"- **{patient.Name}** · " +
                $"{patient.Age} yrs · " +
                $"{patient.AppointmentDate:h:mm tt} · " +
                $"{patient.Reason}");
        }

        result.AppendLine();
        result.AppendLine(
            $"**{urgentPatients.Count} urgent patient(s)** " +
            "currently require priority review.");

        if (urgentPatients.Count > 0)
        {
            result.AppendLine();
            result.AppendLine(
                $"**First recommended review:** " +
                $"{urgentPatients[0].Name}");
        }

        return result.ToString();
    }
    private string GetQueueAnswer()
{
    if (WaitingCount == 0)
    {
        return $"""
### Queue is clear

There are currently **no patients waiting** in the {activeTab.ToLowerInvariant()} view.

- Completed: **{CompletedCount}**
- Doctors available: **{ConsultationCount}**
- Completion rate: **{completionRate}%**

No queue intervention is currently required.
""";
    }

    if (ConsultationCount == 0)
    {
        return $"""
### Queue requires attention

There are **{WaitingCount} patients waiting**, but currently **no doctors are marked as available**.

### Main constraint

Current available clinical capacity is zero.

### Suggested next step

Review doctor availability and active consultations before taking additional appointments.
""";
    }

    var patientsPerDoctor =
        Math.Round(
            WaitingCount / (double)ConsultationCount,
            1);

    var urgentCount = filteredPatients
        .Count(p =>
            !p.IsCompleted &&
            GetPriority(p) == "Urgent");

    var response = new StringBuilder();

    response.AppendLine("### Queue analysis");
    response.AppendLine();

    response.AppendLine(
        $"**{WaitingCount} patients** are waiting across " +
        $"**{ConsultationCount} available doctors**.");

    response.AppendLine();

    response.AppendLine(
        $"That is approximately **{patientsPerDoctor} waiting " +
        $"patients per available doctor**.");

    if (urgentCount > 0)
    {
        response.AppendLine();
        response.AppendLine(
            $"There are also **{urgentCount} urgent patients** " +
            "in the current view.");
    }

    response.AppendLine();

    if (patientsPerDoctor >= 5)
    {
        response.AppendLine("### Recommended action");
        response.AppendLine();
        response.AppendLine(
            "Current demand is high relative to available capacity. " +
            "Prioritize urgent patients first, then process patients " +
            "by appointment time.");
    }
    else if (patientsPerDoctor >= 3)
    {
        response.AppendLine("### Recommended action");
        response.AppendLine();
        response.AppendLine(
            "The queue is moderately loaded. Keep urgent patients " +
            "at the front of the queue and monitor doctor availability.");
    }
    else
    {
        response.AppendLine("### Assessment");
        response.AppendLine();
        response.AppendLine(
            "Available staffing appears proportionate to the " +
            "current waiting queue.");
    }

    return response.ToString();
}
private string GetDoctorAnswer()
{
    var availableDoctors = Service?.Doctors?
        .Where(d =>
            string.Equals(
                d.Availability,
                "available",
                StringComparison.OrdinalIgnoreCase))
        .ToList();

    if (availableDoctors == null ||
        availableDoctors.Count == 0)
    {
        return $"""
### No doctors currently available

**0 of {doctorCount} doctors** are currently marked available.

There are **{WaitingCount} patient(s)** waiting.

### Suggested action

Review active consultations and doctor availability before starting the next consultation.
""";
    }

    var loadPerDoctor =
        WaitingCount == 0
            ? 0
            : Math.Round(
                WaitingCount /
                (double)availableDoctors.Count,
                1);

    return $"""
### Doctor availability

**{availableDoctors.Count} of {doctorCount} doctors** are currently available.

- Patients waiting: **{WaitingCount}**
- Available doctors: **{availableDoctors.Count}**
- Approximate load: **{loadPerDoctor} waiting patients per available doctor**

There is currently clinical capacity available for the next consultation.
""";
}
private string GetAppointmentAnswer()
{
    var appointments = allPatients
        .Where(p =>
            p.AppointmentDate.Date == Today.Date)
        .OrderBy(p => p.AppointmentDate)
        .ToList();

    if (appointments.Count == 0)
    {
        return $"""
### No appointments

There are no appointments scheduled for **{Today:dd MMMM yyyy}**.
""";
    }

    var next = appointments
        .Where(p => !p.IsCompleted)
        .Where(p => !p.IsCheckedIn)
        .OrderBy(p => p.AppointmentDate)
        .FirstOrDefault();

    var response = new StringBuilder();

    response.AppendLine("### Today's appointments");
    response.AppendLine();

    response.AppendLine(
        $"**{appointments.Count} appointments** are scheduled " +
        $"for {Today:dd MMMM yyyy}.");

    response.AppendLine();

    response.AppendLine($"- Waiting: **{WaitingCount}**");
    response.AppendLine($"- Completed: **{CompletedCount}**");
    response.AppendLine(
        $"- Doctors available: **{ConsultationCount}**");

    if (next != null)
    {
        response.AppendLine();
        response.AppendLine("### Next queued appointment");
        response.AppendLine();

        response.AppendLine($"**{next.Name}**");
        response.AppendLine();

        response.AppendLine(
            $"- Time: **{next.AppointmentDate:h:mm tt}**");

        response.AppendLine(
            $"- Reason: **{next.Reason}**");

        response.AppendLine(
            $"- Priority: **{GetPriority(next)}**");
    }

    return response.ToString();
}

private string GetProgressAnswer()
{
    var remaining =
        Math.Max(
            0,
            TotalPatientsInPeriod - CompletedCount);

    var response = new StringBuilder();

    response.AppendLine("### Clinic progress");
    response.AppendLine();

    response.AppendLine(
        $"**{CompletedCount} of {TotalPatientsInPeriod} visits** " +
        $"have been completed in the current " +
        $"**{activeTab.ToLowerInvariant()}** view.");

    response.AppendLine();

    response.AppendLine(
        $"- Completion rate: **{completionRate}%**");

    response.AppendLine(
        $"- Remaining visits: **{remaining}**");

    response.AppendLine(
        $"- Currently waiting: **{WaitingCount}**");

    response.AppendLine(
        $"- Doctors available: **{ConsultationCount}**");

    if (completionRate >= 80)
    {
        response.AppendLine();
        response.AppendLine(
            "**Status:** The active appointment workload " +
            "is close to completion.");
    }
    else if (completionRate >= 50)
    {
        response.AppendLine();
        response.AppendLine(
            "**Status:** More than half of the active workload " +
            "has been completed.");
    }
    else
    {
        response.AppendLine();
        response.AppendLine(
            "**Status:** Most of the active workload is still pending.");
    }

    return response.ToString();
}private string GetBusiestDayAnswer()
{
    if (dailyAppointments == null ||
        dailyAppointments.Count == 0)
    {
        return """
