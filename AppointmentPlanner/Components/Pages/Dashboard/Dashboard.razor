                    <button type="button" class="ai-suggestion-chip" @onclick="@(() => { activeTab = "Weekly"; showAI = false; })">View weekly load</button>
                    <button type="button" class="ai-suggestion-chip" @onclick="@(() => { searchText = ""; severityFilter = null; showAI = false; })">Clear filters</button>
                </div>
            </div>
        </div>
    }
}
else
{
    <div class="dash-skeleton">
        <div class="sk-row">
            <div class="sk-block"></div>
            <div class="sk-block"></div>
            <div class="sk-block"></div>
            <div class="sk-block"></div>
        </div>
    </div>
