        await Task.Delay(250);

        args.Response = GenerateClinicResponse(args.Prompt);

        await InvokeAsync(StateHasChanged);
    }
    private string GenerateClinicResponse(string prompt)
    {
        if (string.IsNullOrWhiteSpace(prompt))
        {
            return GetAIHelpAnswer();
        }

        var question = prompt
            .Trim()
            .ToLowerInvariant();

        // ------------------------------
        // Next patient / priority
        // ------------------------------

        if (question.Contains("see next") ||
            question.Contains("next patient") ||
            question.Contains("who next") ||
            question.Contains("prioritize") ||
            question.Contains("prioritise"))
        {
            return GetNextPatientAnswer();
        }

        // ------------------------------
        // Urgent / critical
        // ------------------------------

        if (question.Contains("urgent") ||
            question.Contains("critical") ||
            question.Contains("high priority"))
        {
            return GetUrgentPatientsAnswer();
        }

        // ------------------------------
        // Queue / waiting
        // ------------------------------

        if (question.Contains("queue") ||
            question.Contains("waiting") ||
            question.Contains("wait time") ||
            question.Contains("workload"))
        {
            return GetQueueAnswer();
        }

        // ------------------------------
        // Doctors
        // ------------------------------

        if (question.Contains("doctor") ||
            question.Contains("available") ||
            question.Contains("capacity"))
        {
            return GetDoctorAnswer();
        }

        // ------------------------------
        // Completed / progress
        // ------------------------------

        if (question.Contains("completed") ||
            question.Contains("completion") ||
            question.Contains("progress") ||
            question.Contains("performance"))
        {
            return GetProgressAnswer();
        }

        // ------------------------------
        // Appointments
        // ------------------------------

        if (question.Contains("appointment") ||
            question.Contains("schedule"))
        {
            return GetAppointmentAnswer();
        }

        // ------------------------------
        // Busy / busiest
        // ------------------------------

        if (question.Contains("busy") ||
            question.Contains("busiest"))
        {
            return GetBusiestDayAnswer();
        }

        // ------------------------------
        // Summary
        // ------------------------------

        if (question.Contains("summary") ||
            question.Contains("overview") ||
            question.Contains("today") ||
            question.Contains("clinic"))
        {
            return GetClinicSummaryAnswer();
        }

        return GetAIHelpAnswer();
    }
private string GetPriority(PatientRow row)
{
    if (row == null)
        return "Normal";

    if (row.Age >= 65)
        return "Urgent";

    if (row.Age >= 40)
        return "High";

    return "Normal";
}
    private string GetNextPatientAnswer()
    {
        var nextPatient = filteredPatients
            .Where(p => !p.IsCompleted)
            .Where(p => !p.IsCheckedIn)
            .OrderByDescending(GetPriorityScore)
            .ThenBy(p => p.AppointmentDate)
            .FirstOrDefault();

        if (nextPatient == null)
        {
            return """
    ### Queue clear

    There are currently **no waiting patients** in the active view.

    All patients are either already in consultation or completed.
    """;
        }

        var now = DateTime.Now;

        string waitingText;

        if (nextPatient.AppointmentDate > now)
        {
            waitingText = "Appointment has not started yet";
        }
        else
        {
            var minutes = Math.Max(
                0,
                (int)(now - nextPatient.AppointmentDate).TotalMinutes);

            waitingText = $"{minutes} minutes";
        }

        return $"""
    ### Recommended next patient

    **{nextPatient.Name}**

    - **Priority:** {GetPriority(nextPatient)}
    - **Age:** {nextPatient.Age} years
    - **Appointment:** {nextPatient.AppointmentDate:h:mm tt}
    - **Reason:** {nextPatient.Reason}
    - **Waiting:** {waitingText}

    ### Why this patient?

    This patient currently has the highest priority in the **{activeTab}** queue. Patients with the same priority are ordered by appointment time.

    **Recommended action:** Review the patient and start the consultation when appropriate.
    """;
    }
