            }).ToList();
        }
    }

   private int GetAge(DateTime? dob)
    {
        if (!dob.HasValue) return 0;
        var age = Today.Year - dob.Value.Year;
        if (dob.Value.Date > Today.AddYears(-age)) age--;
        return Math.Max(0, age);
    }

    private string GetAgeBucket(int age) => age switch
    {
        <= 12 => "Child",
        <= 19 => "Teen",
        <= 39 => "Adult",
        _ => "Older"
    };

    private string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpperInvariant();
        return (parts[0][0].ToString() + parts[1][0].ToString()).ToUpperInvariant();
    }

    private string FormatCount(int n)
    {
        if (n >= 1000) return (n / 1000.0).ToString("0.#") + "K";
        return n.ToString();
    }

    private double NiceMax(double v)
    {
        if (v <= 0) return 10;
        var pow = Math.Pow(10, Math.Floor(Math.Log10(v)));
        var n = v / pow;
        double nice = n <= 1 ? 1 : n <= 2 ? 2 : n <= 5 ? 5 : 10;
        return nice * pow;
    }

     private string GetStatus(PatientRow row)
        {
            if (row == null)
                return "Waiting";

            if (row.Age >= 65)
                return "Critical";

            if (row.Age >= 40)
                return "Moderate";

            return "Waiting";
        }

        private string GetStatusClass(PatientRow row)
        {
            if (row == null)
                return "waiting-chip";

            if (row.Age >= 65)
                return "critical-chip";

            if (row.Age >= 40)
                return "warning-chip";

            return "waiting-chip";
        }
        private int GetPriorityScore(PatientRow row)
{
    if (row == null)
        return 0;

    if (row.Age >= 65)
        return 3; // Urgent

    if (row.Age >= 40)
        return 2; // High

    return 1;     // Normal
}
        private string GetPriorityClass(PatientRow row)
        {
            if (row == null) return "priority-normal-chip";
            if (row.Age >= 65) return "priority-urgent-chip";
            if (row.Age >= 40) return "priority-high-chip";
            return "priority-normal-chip";
        }

    private bool isDataLoaded;
    
    protected override void OnInitialized()
    {
        weekAnchor = Today.AddDays(-(int)Today.DayOfWeek + (int)DayOfWeek.Monday);
        BuildWeek();
        BuildWeekAppointments();
        BuildPatients();
        BuildDailyAppointments();
        BuildAppointmentTrend();
        BuildDonut();
        var firstFuture = weekDays.FindIndex(d => d.Date.Date >= Today.Date);
        selectedDayIndex = firstFuture < 0 ? 0 : firstFuture;
        SelectDay(selectedDayIndex);
    }

    protected async override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Task.Delay(120);
            isDataLoaded = true;
            StateHasChanged();
        }
    }

