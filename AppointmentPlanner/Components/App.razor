     <link rel="stylesheet" href="@Assets["css/bootstrap/bootstrap.min.css"]" />
    <link rel="shortcut icon" href="favicon.ico" />
    <link id="ap-sf-light" href="_content/Syncfusion.Blazor.Themes/fluent2.css" rel="stylesheet" />
    <link id="ap-sf-dark" href="_content/Syncfusion.Blazor.Themes/fluent2-dark.css" rel="stylesheet" media="(prefers-color-scheme: dark)" />
    <link rel="stylesheet" href="@Assets["css/theme.css"]" />
    <script>
        // Resolve the persisted theme BEFORE first paint so there is no flash.
        // Runs immediately after the Syncfusion <link> tags are parsed so we
        // can toggle their `disabled` attribute synchronously.
        (function () {
            try {
                var stored = localStorage.getItem('ap-theme');
                var osDark = window.matchMedia
                    && window.matchMedia('(prefers-color-scheme: dark)').matches;
                var explicit = stored === 'dark' || stored === 'light';
                var theme = explicit ? stored : (osDark ? 'dark' : 'light');
                document.documentElement.setAttribute('data-theme', theme);

                var light = document.getElementById('ap-sf-light');
                var dark = document.getElementById('ap-sf-dark');
                if (light && dark) {
                    var darkActive = (theme === 'dark');
                    light.disabled = darkActive;
                    dark.disabled = !darkActive;
                }
            } catch (e) { /* ignore */ }
        })();
    </script>
    <ImportMap />

