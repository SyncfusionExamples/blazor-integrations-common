<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <!-- Syncfusion Blazor components (themes are bundled inside this package) -->
    <PackageReference Include="Syncfusion.Blazor.Buttons" Version="34.2.7" />
    <PackageReference Include="Syncfusion.Blazor.Core" Version="34.2.7" />
    <PackageReference Include="Syncfusion.Blazor.DropDowns" Version="34.2.7" />
    <PackageReference Include="Syncfusion.Blazor.Grid" Version="34.2.7" />
    <PackageReference Include="Syncfusion.Blazor.Themes" Version="34.2.7" />
  </ItemGroup>

</Project>
