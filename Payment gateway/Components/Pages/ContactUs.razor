@page "/contact"
@using System.ComponentModel.DataAnnotations

<PageTitle>Contact Us</PageTitle>

<div class="container py-5">
    <h2>Contact Us</h2>

    <div class="row">
        <div class="col-md-6">
            <div class="card p-4">
                <h5>Send us a message</h5>
                <EditForm Model="contactModel" OnValidSubmit="HandleSubmit">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="mb-3">
                        <label class="form-label">Your name</label>
                        <InputText class="form-control" @bind-Value="contactModel.Name" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <InputText class="form-control" @bind-Value="contactModel.Email" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Message</label>
                        <InputTextArea class="form-control" @bind-Value="contactModel.Message" Rows="6" />
                    </div>

                    <button class="btn btn-primary" type="submit">Send Message</button>
                </EditForm>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card p-4">
                <h5>Contact Info</h5>
                <p class="mb-1"><strong>Email:</strong> support@example.com</p>
                <p class="mb-1"><strong>Phone:</strong> +1 (555) 123-4567</p>
                <p class="mb-0"><strong>Address:</strong> 123 Market St, Cityville</p>
            </div>
        </div>
    </div>

    @if (showSuccess)
    {
        <div class="alert alert-success mt-4">Thank you — your message has been sent.</div>
    }
</div>

@code {
    private ContactModel contactModel = new();
    private bool showSuccess;

    private void HandleSubmit()
    {
        // In demo, just show success message
        showSuccess = true;
    }

    class ContactModel
    {
        [Required]
        public string? Name { get; set; }
        [Required, EmailAddress]
        public string? Email { get; set; }
        [Required]
        public string? Message { get; set; }
    }
}
