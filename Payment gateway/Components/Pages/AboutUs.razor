@page "/about"

<PageTitle>About Us</PageTitle>

<div class="container py-5">
    <div class="row">
        <div class="col-md-8">
            <div class="card p-4">
                <h2>About Our Store</h2>
                <p class="lead">We are a small team passionate about building delightful shopping experiences. Our demo shop showcases responsive UI patterns and a clean checkout flow.</p>

                <h5>Our Mission</h5>
                <p>To provide a simple, fast, and beautiful shopping experience for demo purposes — designed with Blazor and Syncfusion components.</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card p-4 text-center">
                <h5>Stats</h5>
                <div class="display-6">20+</div>
                <div class="text-muted">Products</div>
                <hr />
                <div class="display-6">100+</div>
                <div class="text-muted">Demo Orders</div>
            </div>
        </div>
    </div>
</div>
