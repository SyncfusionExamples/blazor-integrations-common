private List<ChartData> GetChartDataForPeriod(string period)
{
    var data = new List<ChartData>();
    
    switch (period)
    {
        case "24hours":
            var last24Hours = DateTime.Now.AddHours(-24);
            for (int i = 0; i < 24; i += 4)
            {
                var hourStart = last24Hours.AddHours(i);
                var hourEnd = hourStart.AddHours(4);
                var ordersInPeriod = orders.Where(o => o.OrderDate >= hourStart && o.OrderDate < hourEnd).ToList();
                var earnings = (double)ordersInPeriod.Sum(o => o.Amount) / 1000.0;
                var profits = earnings * 0.7;
                
                data.Add(new ChartData 
                { 
                    Month = hourStart.ToString("h tt"),
                    Earnings = Math.Round(earnings, 1),
                    TotalProfits = Math.Round(profits, 1)
                });
            }
            chartMaxValue = 30;
            chartInterval = 5;
            break;

        case "7days":
            var last7Days = DateTime.Now.AddDays(-7);
            for (int i = 0; i < 7; i++)
            {
                var day = last7Days.AddDays(i);
                var ordersInDay = orders.Where(o => o.OrderDate.Date == day.Date).ToList();
                var earnings = (double)ordersInDay.Sum(o => o.Amount) / 1000.0;
                var profits = earnings * 0.7;
                
                data.Add(new ChartData 
                { 
                    Month = day.ToString("ddd"),
                    Earnings = Math.Round(earnings, 1),
                    TotalProfits = Math.Round(profits, 1)
                });
            }
            chartMaxValue = 50;
            chartInterval = 10;
            break;

        case "30days":
            var last30Days = DateTime.Now.AddDays(-30);
            for (int i = 0; i < 4; i++)
            {
                var weekStart = last30Days.AddDays(i * 7);
                var weekEnd = weekStart.AddDays(7);
                var ordersInWeek = orders.Where(o => o.OrderDate >= weekStart && o.OrderDate < weekEnd).ToList();
                var earnings = (double)ordersInWeek.Sum(o => o.Amount) / 1000.0;
                var profits = earnings * 0.7;
                
                data.Add(new ChartData 
                { 
                    Month = $"Week {i + 1}",
                    Earnings = Math.Round(earnings, 1),
                    TotalProfits = Math.Round(profits, 1)
                });
            }
            chartMaxValue = 80;
            chartInterval = 20;
            break;

        default: // 12months
            var months = new[] { "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec" };
            var currentDate = DateTime.Now;
            for (int i = 11; i >= 0; i--)
            {
                var monthDate = currentDate.AddMonths(-i);
                var ordersInMonth = orders.Where(o => o.OrderDate.Year == monthDate.Year && o.OrderDate.Month == monthDate.Month).ToList();
                var earnings = (double)ordersInMonth.Sum(o => o.Amount) / 1000.0;
                var profits = earnings * 0.7;
                
                data.Add(new ChartData 
                { 
                    Month = months[monthDate.Month - 1],
                    Earnings = Math.Round(earnings, 1),
                    TotalProfits = Math.Round(profits, 1)
                });
            }
            chartMaxValue = 100;
            chartInterval = 20;
            break;
    }

    return data;
}

