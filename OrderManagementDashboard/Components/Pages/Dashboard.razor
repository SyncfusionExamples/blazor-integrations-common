    private async Task OnSearch(InputEventArgs args)
    {
        searchText = args.Value;
        await ApplyFilters();
    }

    private async Task OnPaymentStatusChange(Syncfusion.Blazor.DropDowns.ChangeEventArgs<string, string> args)
    {
        selectedPaymentStatus = args.Value ?? "All";
        await ApplyFilters();
    }

    private async Task OnReceivedStatusChange(Syncfusion.Blazor.DropDowns.ChangeEventArgs<string, string> args)
    {
        selectedReceivedStatus = args.Value ?? "All";
        await ApplyFilters();
    }

    private async Task OnDateFilterChange(Syncfusion.Blazor.DropDowns.ChangeEventArgs<string, string> args)
    {
        selectedDateFilter = args.Value ?? "All";
        await ApplyFilters();
    }

    private async Task ApplyFilters()
    {
        var result = orders.AsEnumerable();

        // Search filter
        if (!string.IsNullOrWhiteSpace(searchText))
        {
            result = result.Where(o => 
                o.OrderNumber.Contains(searchText, StringComparison.OrdinalIgnoreCase) || 
                o.CustomerName.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                o.Email.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                o.Id.Contains(searchText, StringComparison.OrdinalIgnoreCase));
        }

        // Payment status filter
        if (selectedPaymentStatus != "All")
        {
            if (Enum.TryParse<PaymentStatus>(selectedPaymentStatus, out var paymentStatus))
            {
                result = result.Where(o => o.PaymentStatus == paymentStatus);
            }
        }

        // Received status filter
        if (selectedReceivedStatus != "All")
        {
            if (Enum.TryParse<ReceivedStatus>(selectedReceivedStatus, out var receivedStatus))
            {
                result = result.Where(o => o.ReceivedStatus == receivedStatus);
            }
        }

        // Date filter
        if (selectedDateFilter != "All")
        {
            var today = DateTime.Now.Date;
            result = selectedDateFilter switch
            {
                "Today" => result.Where(o => o.OrderDate.Date == today),
                "Last 7 days" => result.Where(o => o.OrderDate.Date >= today.AddDays(-7)),
                "Last 30 days" => result.Where(o => o.OrderDate.Date >= today.AddDays(-30)),
                _ => result
            };
        }

        filteredOrders = result.ToList();
        await InvokeAsync(StateHasChanged);
    }

    private void SelectPeriod(string period)
    {
        selectedPeriod = period;
        chartData = GetChartDataForPeriod(period);
        StateHasChanged();
    }

    private void ViewOrderDetails(Order order)
    {
        selectedOrder = order;
        showOrderDetailsDialog = true;
    }

    private void CloseOrderDetails()
    {
        showOrderDetailsDialog = false;
        selectedOrder = null;
    }

