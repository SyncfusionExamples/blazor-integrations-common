@page "/orders"

@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Cards
@using OrderManagementDashboard.Models
@using OrderManagementDashboard.Services
@inject IOrderService OrderService

<SfCard>
    <CardHeader>
        <div style="display: flex; justify-content: space-between; align-items: center;">
            <h2>All Orders</h2>
            <SfButton CssClass="e-success">Export</SfButton>
        </div>
    </CardHeader>
    <CardContent>
        <SfGrid DataSource="@OrdersList" AllowPaging="true" AllowSorting="true" AllowFiltering="true">
            <GridPageSettings PageSize="10"></GridPageSettings>
            <GridColumns>
                <GridColumn Type="ColumnType.CheckBox" Width="50"></GridColumn>
                <GridColumn Field="Id" HeaderText="ID" Width="100"></GridColumn>
                <GridColumn Field="OrderNumber" HeaderText="Order Number" Width="120"></GridColumn>
                <GridColumn Field="Amount" HeaderText="Amount" Width="100" Format="C"></GridColumn>
                <GridColumn Field="OrderDate" HeaderText="Order Date" Width="120" Format="dd MMM, yyyy"></GridColumn>
                <GridColumn Field="Email" HeaderText="Email" Width="150"></GridColumn>
                <GridColumn Field="PaymentStatus" HeaderText="Payment Status" Width="120"></GridColumn>
                <GridColumn Field="ReceivedStatus" HeaderText="Received Status" Width="120"></GridColumn>
            </GridColumns>
        </SfGrid>
    </CardContent>
</SfCard>

@code {
    private List<Order> OrdersList = new();

    protected override async Task OnInitializedAsync()
    {
        OrdersList = await OrderService.GetOrdersAsync(1, 10);
    }
}